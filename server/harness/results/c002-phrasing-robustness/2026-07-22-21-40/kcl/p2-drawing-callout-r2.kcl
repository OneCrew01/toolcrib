/*
Generated by Text-to-CAD:
Aluminum plate 50 x 50 x 2 mm. 4X drill 5.0 mm THRU, countersink 100 degrees, equally placed at the four corners with hole centers 10 mm from each adjacent edge, for flush flat head screws
*/
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

plateLength = 50mm
plateWidth = 50mm
plateThickness = 2mm
holeDiameter = 5mm
holeRadius = holeDiameter / 2
holeEdgeOffset = 10mm
holePitchX = plateLength - (2 * holeEdgeOffset)
holePitchY = plateWidth - (2 * holeEdgeOffset)
countersinkAngle = 100deg
countersinkHalfAngle = countersinkAngle / 2
countersinkMajorDiameter = 9.5mm
countersinkMajorRadius = countersinkMajorDiameter / 2
cutOverlap = 0.2mm
countersinkToolTopRadius = countersinkMajorRadius + cutOverlap * tan(countersinkHalfAngle)
countersinkSlopeHeight = (countersinkToolTopRadius - holeRadius) / tan(countersinkHalfAngle)

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateLength
  distance([rightEdge.start, rightEdge.end]) == plateWidth
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateLength / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
}
plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)

holeCutterSketch = sketch(on = XZ) {
  cutterAxis = line(start = [var 0mm, var -0.2mm], end = [var 0mm, var 2.2mm])
  cutterTop = line(start = [var 0mm, var 2.2mm], end = [var 4.988mm, var 2.2mm])
  countersinkSlope = line(start = [var 4.988mm, var 2.2mm], end = [var 2.5mm, var 0.112mm])
  boreWall = line(start = [var 2.5mm, var 0.112mm], end = [var 2.5mm, var -0.2mm])
  cutterBottom = line(start = [var 2.5mm, var -0.2mm], end = [var 0mm, var -0.2mm])

  coincident([cutterAxis.end, cutterTop.start])
  coincident([cutterTop.end, countersinkSlope.start])
  coincident([countersinkSlope.end, boreWall.start])
  coincident([boreWall.end, cutterBottom.start])
  coincident([cutterBottom.end, cutterAxis.start])
  vertical(cutterAxis)
  horizontal(cutterTop)
  vertical(boreWall)
  horizontal(cutterBottom)
  horizontalDistance([cutterAxis.start, ORIGIN]) == 0mm
  verticalDistance([cutterAxis.start, ORIGIN]) == cutOverlap
  verticalDistance([cutterAxis.start, cutterAxis.end]) == plateThickness + 2 * cutOverlap
  horizontalDistance([cutterTop.start, cutterTop.end]) == countersinkToolTopRadius
  horizontalDistance([cutterAxis.start, boreWall.end]) == holeRadius
  verticalDistance([
  countersinkSlope.end,
  countersinkSlope.start
]) == countersinkSlopeHeight
}
holeCutterRegion = region(point = [1mm, 1mm], sketch = holeCutterSketch)
holeCutterSeed = revolve(holeCutterRegion, angle = 360deg, axis = Y)
  |> translate(
       x = -holePitchX / 2,
       y = -holePitchY / 2,
       z = 0mm,
       global = true,
     )
holeCutters = patternLinear3d(
  patternLinear3d(
    holeCutterSeed,
    instances = 2,
    distance = holePitchX,
    axis = X,
  ),
  instances = 2,
  distance = holePitchY,
  axis = Y,
)
plateCountersunk = subtract(plateBlank, tools = holeCutters)

hide(plateSketch)
hide(holeCutterSketch)

finishedPlate = appearance(
  plateCountersunk,
  color = "#c7cbd1",
  metalness = 88,
  roughness = 28,
)
