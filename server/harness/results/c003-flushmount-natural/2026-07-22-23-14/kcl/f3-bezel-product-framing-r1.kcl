/*
Generated by Text-to-CAD:
An instrument face plate in aluminum, 60mm wide, 60mm tall, 3mm thick, with a square instrument opening 32mm across in the middle, plus a separate blanking bezel that snaps into the opening and finishes flush with the front of the plate. Fit clearance 0.15mm around the bezel, chamfered edges so it leads in smoothly, plate anodized black and bezel bright red so they read as two components.
*/
@settings(defaultLengthUnit = mm)

plateWidth = 60mm
plateHeight = 60mm
plateThickness = 3mm
openingSize = 32mm
openingLeadChamfer = 0.6mm
fitClearance = 0.15mm
bezelFitSize = openingSize - (2 * fitClearance)

// Base aluminum face plate.
plateProfile = sketch(on = XY) {
  bottomEdge = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  rightEdge = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  topEdge = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  leftEdge = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == plateWidth
  verticalDistance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateBlank = extrude(region(point = [0mm, 0mm], sketch = plateProfile), length = plateThickness)

// Nominal 32 mm opening with a front lead-in chamfer.
openingRearProfile = sketch(on = offsetPlane(XY, offset = -0.2mm)) {
  bottomEdge = line(start = [var -16mm, var -16mm], end = [var 16mm, var -16mm])
  rightEdge = line(start = [var 16mm, var -16mm], end = [var 16mm, var 16mm])
  topEdge = line(start = [var 16mm, var 16mm], end = [var -16mm, var 16mm])
  leftEdge = line(start = [var -16mm, var 16mm], end = [var -16mm, var -16mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == openingSize
  verticalDistance([rightEdge.start, rightEdge.end]) == openingSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == openingSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == openingSize / 2
}

openingChamferStartProfile = sketch(on = offsetPlane(XY, offset = 2.2mm)) {
  bottomEdge = line(start = [var -16mm, var -16mm], end = [var 16mm, var -16mm])
  rightEdge = line(start = [var 16mm, var -16mm], end = [var 16mm, var 16mm])
  topEdge = line(start = [var 16mm, var 16mm], end = [var -16mm, var 16mm])
  leftEdge = line(start = [var -16mm, var 16mm], end = [var -16mm, var -16mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == openingSize
  verticalDistance([rightEdge.start, rightEdge.end]) == openingSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == openingSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == openingSize / 2
}

openingFrontProfile = sketch(on = offsetPlane(XY, offset = 3.2mm)) {
  bottomEdge = line(start = [var -16.6mm, var -16.6mm], end = [var 16.6mm, var -16.6mm])
  rightEdge = line(start = [var 16.6mm, var -16.6mm], end = [var 16.6mm, var 16.6mm])
  topEdge = line(start = [var 16.6mm, var 16.6mm], end = [var -16.6mm, var 16.6mm])
  leftEdge = line(start = [var -16.6mm, var 16.6mm], end = [var -16.6mm, var -16.6mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == openingSize + 2 * openingLeadChamfer
  verticalDistance([rightEdge.start, rightEdge.end]) == openingSize + 2 * openingLeadChamfer
  horizontalDistance([bottomEdge.start, ORIGIN]) == openingSize / 2 + openingLeadChamfer
  verticalDistance([bottomEdge.start, ORIGIN]) == openingSize / 2 + openingLeadChamfer
}

openingCutter = loft([
  region(point = [0mm, 0mm], sketch = openingRearProfile),
  region(point = [0mm, 0mm], sketch = openingChamferStartProfile),
  region(point = [0mm, 0mm], sketch = openingFrontProfile)
])

plateWithOpening = subtract([plateBlank], tools = [openingCutter])
facePlate = plateWithOpening
  |> appearance(color = "#111317", roughness = 34, metalness = 82)

// Flush front bezel: widest seating band is 31.70 mm for 0.15 mm clearance per side.
bezelLowerProfile = sketch(on = offsetPlane(XY, offset = 1.9mm)) {
  bottomEdge = line(start = [var -15.5mm, var -15.5mm], end = [var 15.5mm, var -15.5mm])
  rightEdge = line(start = [var 15.5mm, var -15.5mm], end = [var 15.5mm, var 15.5mm])
  topEdge = line(start = [var 15.5mm, var 15.5mm], end = [var -15.5mm, var 15.5mm])
  leftEdge = line(start = [var -15.5mm, var 15.5mm], end = [var -15.5mm, var -15.5mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == 31mm
  verticalDistance([rightEdge.start, rightEdge.end]) == 31mm
  horizontalDistance([bottomEdge.start, ORIGIN]) == 15.5mm
  verticalDistance([bottomEdge.start, ORIGIN]) == 15.5mm
}

bezelSeatProfile = sketch(on = offsetPlane(XY, offset = 2.15mm)) {
  bottomEdge = line(start = [var -15.85mm, var -15.85mm], end = [var 15.85mm, var -15.85mm])
  rightEdge = line(start = [var 15.85mm, var -15.85mm], end = [var 15.85mm, var 15.85mm])
  topEdge = line(start = [var 15.85mm, var 15.85mm], end = [var -15.85mm, var 15.85mm])
  leftEdge = line(start = [var -15.85mm, var 15.85mm], end = [var -15.85mm, var -15.85mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == bezelFitSize
  verticalDistance([rightEdge.start, rightEdge.end]) == bezelFitSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == bezelFitSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == bezelFitSize / 2
}

bezelUpperProfile = sketch(on = offsetPlane(XY, offset = 2.75mm)) {
  bottomEdge = line(start = [var -15.85mm, var -15.85mm], end = [var 15.85mm, var -15.85mm])
  rightEdge = line(start = [var 15.85mm, var -15.85mm], end = [var 15.85mm, var 15.85mm])
  topEdge = line(start = [var 15.85mm, var 15.85mm], end = [var -15.85mm, var 15.85mm])
  leftEdge = line(start = [var -15.85mm, var 15.85mm], end = [var -15.85mm, var -15.85mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == bezelFitSize
  verticalDistance([rightEdge.start, rightEdge.end]) == bezelFitSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == bezelFitSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == bezelFitSize / 2
}

bezelTopProfile = sketch(on = offsetPlane(XY, offset = plateThickness)) {
  bottomEdge = line(start = [var -15.65mm, var -15.65mm], end = [var 15.65mm, var -15.65mm])
  rightEdge = line(start = [var 15.65mm, var -15.65mm], end = [var 15.65mm, var 15.65mm])
  topEdge = line(start = [var 15.65mm, var 15.65mm], end = [var -15.65mm, var 15.65mm])
  leftEdge = line(start = [var -15.65mm, var 15.65mm], end = [var -15.65mm, var -15.65mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == 31.3mm
  verticalDistance([rightEdge.start, rightEdge.end]) == 31.3mm
  horizontalDistance([bottomEdge.start, ORIGIN]) == 15.65mm
  verticalDistance([bottomEdge.start, ORIGIN]) == 15.65mm
}

bezelFace = loft([
  region(point = [0mm, 0mm], sketch = bezelLowerProfile),
  region(point = [0mm, 0mm], sketch = bezelSeatProfile),
  region(point = [0mm, 0mm], sketch = bezelUpperProfile),
  region(point = [0mm, 0mm], sketch = bezelTopProfile)
])

// Tapered rear boss stiffens the blank while leaving flex space beside the clips.
bezelBossBottomProfile = sketch(on = offsetPlane(XY, offset = -1.4mm)) {
  bottomEdge = line(start = [var -11.75mm, var -11.75mm], end = [var 11.75mm, var -11.75mm])
  rightEdge = line(start = [var 11.75mm, var -11.75mm], end = [var 11.75mm, var 11.75mm])
  topEdge = line(start = [var 11.75mm, var 11.75mm], end = [var -11.75mm, var 11.75mm])
  leftEdge = line(start = [var -11.75mm, var 11.75mm], end = [var -11.75mm, var -11.75mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == 23.5mm
  verticalDistance([rightEdge.start, rightEdge.end]) == 23.5mm
  horizontalDistance([bottomEdge.start, ORIGIN]) == 11.75mm
  verticalDistance([bottomEdge.start, ORIGIN]) == 11.75mm
}

bezelBossTopProfile = sketch(on = offsetPlane(XY, offset = 2.05mm)) {
  bottomEdge = line(start = [var -12.25mm, var -12.25mm], end = [var 12.25mm, var -12.25mm])
  rightEdge = line(start = [var 12.25mm, var -12.25mm], end = [var 12.25mm, var 12.25mm])
  topEdge = line(start = [var 12.25mm, var 12.25mm], end = [var -12.25mm, var 12.25mm])
  leftEdge = line(start = [var -12.25mm, var 12.25mm], end = [var -12.25mm, var -12.25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  horizontalDistance([bottomEdge.start, bottomEdge.end]) == 24.5mm
  verticalDistance([rightEdge.start, rightEdge.end]) == 24.5mm
  horizontalDistance([bottomEdge.start, ORIGIN]) == 12.25mm
  verticalDistance([bottomEdge.start, ORIGIN]) == 12.25mm
}

bezelBoss = loft([
  region(point = [0mm, 0mm], sketch = bezelBossBottomProfile),
  region(point = [0mm, 0mm], sketch = bezelBossTopProfile)
])

// Opposed cantilever arms fit within the opening and flex inward during insertion.
snapArmProfile = sketch(on = offsetPlane(XY, offset = -1.8mm)) {
  rightBottom = line(start = [var 13.5mm, var -5mm], end = [var 15mm, var -5mm])
  rightOuter = line(start = [var 15mm, var -5mm], end = [var 15mm, var 5mm])
  rightTop = line(start = [var 15mm, var 5mm], end = [var 13.5mm, var 5mm])
  rightInner = line(start = [var 13.5mm, var 5mm], end = [var 13.5mm, var -5mm])

  leftBottom = line(start = [var -15mm, var -5mm], end = [var -13.5mm, var -5mm])
  leftInner = line(start = [var -13.5mm, var -5mm], end = [var -13.5mm, var 5mm])
  leftTop = line(start = [var -13.5mm, var 5mm], end = [var -15mm, var 5mm])
  leftOuter = line(start = [var -15mm, var 5mm], end = [var -15mm, var -5mm])

  coincident([rightBottom.end, rightOuter.start])
  coincident([rightOuter.end, rightTop.start])
  coincident([rightTop.end, rightInner.start])
  coincident([rightInner.end, rightBottom.start])
  coincident([leftBottom.end, leftInner.start])
  coincident([leftInner.end, leftTop.start])
  coincident([leftTop.end, leftOuter.start])
  coincident([leftOuter.end, leftBottom.start])

  horizontal(rightBottom)
  vertical(rightOuter)
  horizontal(rightTop)
  vertical(rightInner)
  horizontal(leftBottom)
  vertical(leftInner)
  horizontal(leftTop)
  vertical(leftOuter)

  horizontalDistance([rightBottom.start, rightBottom.end]) == 1.5mm
  verticalDistance([rightBottom.start, rightInner.start]) == 10mm
  horizontalDistance([ORIGIN, rightBottom.start]) == 13.5mm
  verticalDistance([rightBottom.start, ORIGIN]) == 5mm

  horizontalDistance([leftBottom.start, leftBottom.end]) == 1.5mm
  verticalDistance([leftBottom.start, leftOuter.start]) == 10mm
  horizontalDistance([leftBottom.start, ORIGIN]) == 15mm
  verticalDistance([leftBottom.start, ORIGIN]) == 5mm
}

rightSnapArm = extrude(region(point = [14mm, 0mm], sketch = snapArmProfile), length = 3.85mm)
leftSnapArm = extrude(region(point = [-14mm, 0mm], sketch = snapArmProfile), length = 3.85mm)

// Wedge-shaped barbs lead into the opening and retain below the rear face.
snapHookTipProfile = sketch(on = offsetPlane(XY, offset = -1.8mm)) {
  rightBottom = line(start = [var 14.2mm, var -5mm], end = [var 15mm, var -5mm])
  rightOuter = line(start = [var 15mm, var -5mm], end = [var 15mm, var 5mm])
  rightTop = line(start = [var 15mm, var 5mm], end = [var 14.2mm, var 5mm])
  rightInner = line(start = [var 14.2mm, var 5mm], end = [var 14.2mm, var -5mm])

  leftBottom = line(start = [var -15mm, var -5mm], end = [var -14.2mm, var -5mm])
  leftInner = line(start = [var -14.2mm, var -5mm], end = [var -14.2mm, var 5mm])
  leftTop = line(start = [var -14.2mm, var 5mm], end = [var -15mm, var 5mm])
  leftOuter = line(start = [var -15mm, var 5mm], end = [var -15mm, var -5mm])

  coincident([rightBottom.end, rightOuter.start])
  coincident([rightOuter.end, rightTop.start])
  coincident([rightTop.end, rightInner.start])
  coincident([rightInner.end, rightBottom.start])
  coincident([leftBottom.end, leftInner.start])
  coincident([leftInner.end, leftTop.start])
  coincident([leftTop.end, leftOuter.start])
  coincident([leftOuter.end, leftBottom.start])

  horizontal(rightBottom)
  vertical(rightOuter)
  horizontal(rightTop)
  vertical(rightInner)
  horizontal(leftBottom)
  vertical(leftInner)
  horizontal(leftTop)
  vertical(leftOuter)

  horizontalDistance([rightBottom.start, rightBottom.end]) == 0.8mm
  verticalDistance([rightBottom.start, rightInner.start]) == 10mm
  horizontalDistance([ORIGIN, rightBottom.start]) == 14.2mm
  verticalDistance([rightBottom.start, ORIGIN]) == 5mm

  horizontalDistance([leftBottom.start, leftBottom.end]) == 0.8mm
  verticalDistance([leftBottom.start, leftOuter.start]) == 10mm
  horizontalDistance([leftBottom.start, ORIGIN]) == 15mm
  verticalDistance([leftBottom.start, ORIGIN]) == 5mm
}

snapHookShoulderProfile = sketch(on = offsetPlane(XY, offset = -0.15mm)) {
  rightBottom = line(start = [var 14.2mm, var -5mm], end = [var 16.35mm, var -5mm])
  rightOuter = line(start = [var 16.35mm, var -5mm], end = [var 16.35mm, var 5mm])
  rightTop = line(start = [var 16.35mm, var 5mm], end = [var 14.2mm, var 5mm])
  rightInner = line(start = [var 14.2mm, var 5mm], end = [var 14.2mm, var -5mm])

  leftBottom = line(start = [var -16.35mm, var -5mm], end = [var -14.2mm, var -5mm])
  leftInner = line(start = [var -14.2mm, var -5mm], end = [var -14.2mm, var 5mm])
  leftTop = line(start = [var -14.2mm, var 5mm], end = [var -16.35mm, var 5mm])
  leftOuter = line(start = [var -16.35mm, var 5mm], end = [var -16.35mm, var -5mm])

  coincident([rightBottom.end, rightOuter.start])
  coincident([rightOuter.end, rightTop.start])
  coincident([rightTop.end, rightInner.start])
  coincident([rightInner.end, rightBottom.start])
  coincident([leftBottom.end, leftInner.start])
  coincident([leftInner.end, leftTop.start])
  coincident([leftTop.end, leftOuter.start])
  coincident([leftOuter.end, leftBottom.start])

  horizontal(rightBottom)
  vertical(rightOuter)
  horizontal(rightTop)
  vertical(rightInner)
  horizontal(leftBottom)
  vertical(leftInner)
  horizontal(leftTop)
  vertical(leftOuter)

  horizontalDistance([rightBottom.start, rightBottom.end]) == 2.15mm
  verticalDistance([rightBottom.start, rightInner.start]) == 10mm
  horizontalDistance([ORIGIN, rightBottom.start]) == 14.2mm
  verticalDistance([rightBottom.start, ORIGIN]) == 5mm

  horizontalDistance([leftBottom.start, leftBottom.end]) == 2.15mm
  verticalDistance([leftBottom.start, leftOuter.start]) == 10mm
  horizontalDistance([leftBottom.start, ORIGIN]) == 16.35mm
  verticalDistance([leftBottom.start, ORIGIN]) == 5mm
}

rightSnapHook = loft([
  region(point = [14.5mm, 0mm], sketch = snapHookTipProfile),
  region(point = [15.5mm, 0mm], sketch = snapHookShoulderProfile)
])
leftSnapHook = loft([
  region(point = [-14.5mm, 0mm], sketch = snapHookTipProfile),
  region(point = [-15.5mm, 0mm], sketch = snapHookShoulderProfile)
])

blankingBezel = appearance(
  [
    bezelFace,
    bezelBoss,
    rightSnapArm,
    leftSnapArm,
    rightSnapHook,
    leftSnapHook
  ],
  color = "#f01924",
  roughness = 28,
  metalness = 2,
)

hide([
  plateProfile,
  openingRearProfile,
  openingChamferStartProfile,
  openingFrontProfile,
  bezelLowerProfile,
  bezelSeatProfile,
  bezelUpperProfile,
  bezelTopProfile,
  bezelBossBottomProfile,
  bezelBossTopProfile,
  snapArmProfile,
  snapHookTipProfile,
  snapHookShoulderProfile
])
