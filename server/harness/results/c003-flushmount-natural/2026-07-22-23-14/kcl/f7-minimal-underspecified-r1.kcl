/*
Generated by Text-to-CAD:
60mm square 3mm aluminum panel with a square hole and a matching flush insert, 0.15mm clearance, chamfered lead-in edges, panel and insert in two different colors
*/
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

panelSide = 60mm
panelThickness = 3mm
holeSide = 30mm
clearancePerSide = 0.15mm
insertSide = holeSide - (2 * clearancePerSide)
panelLeadDepth = 0.5mm
panelLeadWidth = 0.5mm
insertLeadDepth = 0.45mm
insertLeadWidth = 0.5mm

panelProfile = sketch(on = XY) {
  panelFront = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  panelRight = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  panelBack = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  panelLeft = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])

  coincident([panelFront.end, panelRight.start])
  coincident([panelRight.end, panelBack.start])
  coincident([panelBack.end, panelLeft.start])
  coincident([panelLeft.end, panelFront.start])
  horizontal(panelFront)
  vertical(panelRight)
  horizontal(panelBack)
  vertical(panelLeft)
  horizontalDistance([panelFront.start, panelFront.end]) == panelSide
  verticalDistance([panelRight.start, panelRight.end]) == panelSide
  horizontalDistance([panelFront.start, ORIGIN]) == panelSide / 2
  verticalDistance([panelFront.start, ORIGIN]) == panelSide / 2
}

holeLowerProfile = sketch(on = offsetPlane(XY, offset = -0.2mm)) {
  holeLowerFront = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  holeLowerRight = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  holeLowerBack = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  holeLowerLeft = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])

  coincident([
    holeLowerFront.end,
    holeLowerRight.start
  ])
  coincident([
    holeLowerRight.end,
    holeLowerBack.start
  ])
  coincident([holeLowerBack.end, holeLowerLeft.start])
  coincident([
    holeLowerLeft.end,
    holeLowerFront.start
  ])
  horizontal(holeLowerFront)
  vertical(holeLowerRight)
  horizontal(holeLowerBack)
  vertical(holeLowerLeft)
  horizontalDistance([
  holeLowerFront.start,
  holeLowerFront.end
]) == holeSide
  verticalDistance([
  holeLowerRight.start,
  holeLowerRight.end
]) == holeSide
  horizontalDistance([holeLowerFront.start, ORIGIN]) == holeSide / 2
  verticalDistance([holeLowerFront.start, ORIGIN]) == holeSide / 2
}

holeLeadStartProfile = sketch(on = offsetPlane(XY, offset = panelThickness - panelLeadDepth)) {
  holeLeadFront = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  holeLeadRight = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  holeLeadBack = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  holeLeadLeft = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])

  coincident([holeLeadFront.end, holeLeadRight.start])
  coincident([holeLeadRight.end, holeLeadBack.start])
  coincident([holeLeadBack.end, holeLeadLeft.start])
  coincident([holeLeadLeft.end, holeLeadFront.start])
  horizontal(holeLeadFront)
  vertical(holeLeadRight)
  horizontal(holeLeadBack)
  vertical(holeLeadLeft)
  horizontalDistance([holeLeadFront.start, holeLeadFront.end]) == holeSide
  verticalDistance([holeLeadRight.start, holeLeadRight.end]) == holeSide
  horizontalDistance([holeLeadFront.start, ORIGIN]) == holeSide / 2
  verticalDistance([holeLeadFront.start, ORIGIN]) == holeSide / 2
}

holeLeadTopProfile = sketch(on = offsetPlane(XY, offset = panelThickness + 0.1mm)) {
  holeTopFront = line(start = [var -15.5mm, var -15.5mm], end = [var 15.5mm, var -15.5mm])
  holeTopRight = line(start = [var 15.5mm, var -15.5mm], end = [var 15.5mm, var 15.5mm])
  holeTopBack = line(start = [var 15.5mm, var 15.5mm], end = [var -15.5mm, var 15.5mm])
  holeTopLeft = line(start = [var -15.5mm, var 15.5mm], end = [var -15.5mm, var -15.5mm])

  coincident([holeTopFront.end, holeTopRight.start])
  coincident([holeTopRight.end, holeTopBack.start])
  coincident([holeTopBack.end, holeTopLeft.start])
  coincident([holeTopLeft.end, holeTopFront.start])
  horizontal(holeTopFront)
  vertical(holeTopRight)
  horizontal(holeTopBack)
  vertical(holeTopLeft)
  horizontalDistance([holeTopFront.start, holeTopFront.end]) == holeSide + 2 * panelLeadWidth
  verticalDistance([holeTopRight.start, holeTopRight.end]) == holeSide + 2 * panelLeadWidth
  horizontalDistance([holeTopFront.start, ORIGIN]) == holeSide / 2 + panelLeadWidth
  verticalDistance([holeTopFront.start, ORIGIN]) == holeSide / 2 + panelLeadWidth
}

insertBottomProfile = sketch(on = XY) {
  insertBottomFront = line(start = [var -14.35mm, var -14.35mm], end = [var 14.35mm, var -14.35mm])
  insertBottomRight = line(start = [var 14.35mm, var -14.35mm], end = [var 14.35mm, var 14.35mm])
  insertBottomBack = line(start = [var 14.35mm, var 14.35mm], end = [var -14.35mm, var 14.35mm])
  insertBottomLeft = line(start = [var -14.35mm, var 14.35mm], end = [var -14.35mm, var -14.35mm])

  coincident([
    insertBottomFront.end,
    insertBottomRight.start
  ])
  coincident([
    insertBottomRight.end,
    insertBottomBack.start
  ])
  coincident([
    insertBottomBack.end,
    insertBottomLeft.start
  ])
  coincident([
    insertBottomLeft.end,
    insertBottomFront.start
  ])
  horizontal(insertBottomFront)
  vertical(insertBottomRight)
  horizontal(insertBottomBack)
  vertical(insertBottomLeft)
  horizontalDistance([
  insertBottomFront.start,
  insertBottomFront.end
]) == insertSide - (2 * insertLeadWidth)
  verticalDistance([
  insertBottomRight.start,
  insertBottomRight.end
]) == insertSide - (2 * insertLeadWidth)
  horizontalDistance([insertBottomFront.start, ORIGIN]) == insertSide / 2 - insertLeadWidth
  verticalDistance([insertBottomFront.start, ORIGIN]) == insertSide / 2 - insertLeadWidth
}

insertFullProfile = sketch(on = offsetPlane(XY, offset = insertLeadDepth)) {
  insertFullFront = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  insertFullRight = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  insertFullBack = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  insertFullLeft = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([
    insertFullFront.end,
    insertFullRight.start
  ])
  coincident([
    insertFullRight.end,
    insertFullBack.start
  ])
  coincident([
    insertFullBack.end,
    insertFullLeft.start
  ])
  coincident([
    insertFullLeft.end,
    insertFullFront.start
  ])
  horizontal(insertFullFront)
  vertical(insertFullRight)
  horizontal(insertFullBack)
  vertical(insertFullLeft)
  horizontalDistance([
  insertFullFront.start,
  insertFullFront.end
]) == insertSide
  verticalDistance([
  insertFullRight.start,
  insertFullRight.end
]) == insertSide
  horizontalDistance([insertFullFront.start, ORIGIN]) == insertSide / 2
  verticalDistance([insertFullFront.start, ORIGIN]) == insertSide / 2
}

insertTopProfile = sketch(on = offsetPlane(XY, offset = panelThickness)) {
  insertTopFront = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  insertTopRight = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  insertTopBack = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  insertTopLeft = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([
    insertTopFront.end,
    insertTopRight.start
  ])
  coincident([
    insertTopRight.end,
    insertTopBack.start
  ])
  coincident([insertTopBack.end, insertTopLeft.start])
  coincident([
    insertTopLeft.end,
    insertTopFront.start
  ])
  horizontal(insertTopFront)
  vertical(insertTopRight)
  horizontal(insertTopBack)
  vertical(insertTopLeft)
  horizontalDistance([
  insertTopFront.start,
  insertTopFront.end
]) == insertSide
  verticalDistance([
  insertTopRight.start,
  insertTopRight.end
]) == insertSide
  horizontalDistance([insertTopFront.start, ORIGIN]) == insertSide / 2
  verticalDistance([insertTopFront.start, ORIGIN]) == insertSide / 2
}

panelRegion = region(point = [0mm, 0mm], sketch = panelProfile)
holeLowerRegion = region(point = [0mm, 0mm], sketch = holeLowerProfile)
holeLeadStartRegion = region(point = [0mm, 0mm], sketch = holeLeadStartProfile)
holeLeadTopRegion = region(point = [0mm, 0mm], sketch = holeLeadTopProfile)
insertBottomRegion = region(point = [0mm, 0mm], sketch = insertBottomProfile)
insertFullRegion = region(point = [0mm, 0mm], sketch = insertFullProfile)
insertTopRegion = region(point = [0mm, 0mm], sketch = insertTopProfile)

panelBlank = extrude(panelRegion, length = panelThickness)
holeCutter = loft(
  [
    holeLowerRegion,
    holeLeadStartRegion,
    holeLeadTopRegion
  ],
  vDegree = 1,
)

panelBody = subtract([panelBlank], tools = [holeCutter])
  |> appearance(color = "#b8c0c7", metalness = 92, roughness = 28)

flushInsert = loft(
  [
    insertBottomRegion,
    insertFullRegion,
    insertTopRegion
  ],
  vDegree = 1,
)
  |> appearance(color = "#1769aa", metalness = 82, roughness = 30)

hide([
  panelProfile,
  holeLowerProfile,
  holeLeadStartProfile,
  holeLeadTopProfile,
  insertBottomProfile,
  insertFullProfile,
  insertTopProfile
])

panelBody
flushInsert
