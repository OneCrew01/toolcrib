/*
Generated by Text-to-CAD:
Aluminum panel, 60 by 60, 3 thick, with a square window about 30 across cut in the center, and a little square plug that drops in that window and sits smooth with the face — leave it a hair small, 0.15 per side, break the edges with a chamfer so it starts easy, all in millimeters. Paint the panel silver and the plug dark blue so you can see the joint.
*/
@settings(defaultLengthUnit = mm)

panelSize = 60mm
panelThickness = 3mm
windowSize = 30mm
clearancePerSide = 0.15mm
plugSize = windowSize - (2 * clearancePerSide)
plugChamfer = 0.5mm
plugChamferHeight = 0.5mm
plugLeadSize = plugSize - (2 * plugChamfer)

panelProfile = sketch(on = XY) {
  bottom = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  right = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  top = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  left = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([bottom.start, bottom.end]) == panelSize
  verticalDistance([right.start, right.end]) == panelSize
  horizontalDistance([bottom.start, ORIGIN]) == panelSize / 2
  verticalDistance([bottom.start, ORIGIN]) == panelSize / 2
}

windowProfile = sketch(on = offsetPlane(XY, offset = -0.5mm)) {
  bottom = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  right = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  top = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  left = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([bottom.start, bottom.end]) == windowSize
  verticalDistance([right.start, right.end]) == windowSize
  horizontalDistance([bottom.start, ORIGIN]) == windowSize / 2
  verticalDistance([bottom.start, ORIGIN]) == windowSize / 2
}

plugBottomProfile = sketch(on = XY) {
  bottom = line(start = [var -14.35mm, var -14.35mm], end = [var 14.35mm, var -14.35mm])
  right = line(start = [var 14.35mm, var -14.35mm], end = [var 14.35mm, var 14.35mm])
  top = line(start = [var 14.35mm, var 14.35mm], end = [var -14.35mm, var 14.35mm])
  left = line(start = [var -14.35mm, var 14.35mm], end = [var -14.35mm, var -14.35mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([bottom.start, bottom.end]) == plugLeadSize
  verticalDistance([right.start, right.end]) == plugLeadSize
  horizontalDistance([bottom.start, ORIGIN]) == plugLeadSize / 2
  verticalDistance([bottom.start, ORIGIN]) == plugLeadSize / 2
}

plugChamferProfile = sketch(on = offsetPlane(XY, offset = plugChamferHeight)) {
  bottom = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  right = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  top = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  left = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([bottom.start, bottom.end]) == plugSize
  verticalDistance([right.start, right.end]) == plugSize
  horizontalDistance([bottom.start, ORIGIN]) == plugSize / 2
  verticalDistance([bottom.start, ORIGIN]) == plugSize / 2
}

plugTopProfile = sketch(on = offsetPlane(XY, offset = panelThickness)) {
  bottom = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  right = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  top = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  left = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([bottom.start, bottom.end]) == plugSize
  verticalDistance([right.start, right.end]) == plugSize
  horizontalDistance([bottom.start, ORIGIN]) == plugSize / 2
  verticalDistance([bottom.start, ORIGIN]) == plugSize / 2
}

panelBlank = extrude(region(point = [25mm, 0mm], sketch = panelProfile), length = panelThickness)
windowCutter = extrude(region(point = [0mm, 0mm], sketch = windowProfile), length = panelThickness + 1mm)
panelWithWindow = subtract(panelBlank, tools = [windowCutter])
  |> appearance(color = "#c6cbd0", roughness = 24, metalness = 92)

plugBottomRegion = region(point = [0mm, 0mm], sketch = plugBottomProfile)
plugChamferRegion = region(point = [0mm, 0mm], sketch = plugChamferProfile)
plugTopRegion = region(point = [0mm, 0mm], sketch = plugTopProfile)
windowPlug = loft(
  [
    plugBottomRegion,
    plugChamferRegion,
    plugTopRegion
  ],
  vDegree = 1,
)
  |> appearance(color = "#173f73", roughness = 30, metalness = 62)

hide(panelProfile)
hide(windowProfile)
hide(plugBottomProfile)
hide(plugChamferProfile)
hide(plugTopProfile)

panelAndPlug = [panelWithWindow, windowPlug]
panelAndPlug
