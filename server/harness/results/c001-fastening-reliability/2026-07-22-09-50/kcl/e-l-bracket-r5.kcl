/*
Generated by Text-to-CAD:
An L-shaped aluminum bracket, 2mm thick, with two rectangular legs each 40mm long and 40mm wide meeting at 90 degrees, with two 5mm diameter holes in each leg, each hole center 10mm from the free end of its leg and 10mm from the nearest side edge
*/
@settings(defaultLengthUnit = mm)

legLength = 40mm
bracketWidth = 40mm
materialThickness = 2mm
holeDiameter = 5mm
endOffset = 10mm
sideOffset = 10mm
holeCenterFromBend = legLength - endOffset
holeRowOffset = bracketWidth / 2 - sideOffset
cutterLength = materialThickness + 2mm

bracketProfileSketch = sketch(on = XZ) {
  horizontalOuter = line(start = [var 0mm, var 0mm], end = [var 40mm, var 0mm])
  horizontalTip = line(start = [var 40mm, var 0mm], end = [var 40mm, var 2mm])
  horizontalInner = line(start = [var 40mm, var 2mm], end = [var 2mm, var 2mm])
  verticalInner = line(start = [var 2mm, var 2mm], end = [var 2mm, var 40mm])
  verticalTip = line(start = [var 2mm, var 40mm], end = [var 0mm, var 40mm])
  verticalOuter = line(start = [var 0mm, var 40mm], end = [var 0mm, var 0mm])

  coincident([
    horizontalOuter.end,
    horizontalTip.start
  ])
  coincident([
    horizontalTip.end,
    horizontalInner.start
  ])
  coincident([
    horizontalInner.end,
    verticalInner.start
  ])
  coincident([verticalInner.end, verticalTip.start])
  coincident([verticalTip.end, verticalOuter.start])
  coincident([
    verticalOuter.end,
    horizontalOuter.start
  ])
  coincident([horizontalOuter.start, ORIGIN])

  horizontal(horizontalOuter)
  vertical(horizontalTip)
  horizontal(horizontalInner)
  vertical(verticalInner)
  horizontal(verticalTip)
  vertical(verticalOuter)

  horizontalDistance([
  horizontalOuter.start,
  horizontalOuter.end
]) == legLength
  verticalDistance([horizontalTip.start, horizontalTip.end]) == materialThickness
  verticalDistance([verticalOuter.end, verticalOuter.start]) == legLength
  horizontalDistance([verticalTip.end, verticalTip.start]) == materialThickness
}

bracketProfileRegion = region(point = [1mm, 20mm], sketch = bracketProfileSketch)
bracketBlank = extrude(bracketProfileRegion, length = bracketWidth, symmetric = true)
hide(bracketProfileSketch)

horizontalHoleSketch = sketch(on = XY) {
  negativeRowCircle = circle(start = [var 32.5mm, var -10mm], center = [var 30mm, var -10mm])
  negativeRowGuide = line(start = [var 30mm, var -10mm], end = [var 32.5mm, var -10mm], construction = true)
  coincident([
    negativeRowGuide.start,
    negativeRowCircle.center
  ])
  coincident([
    negativeRowGuide.end,
    negativeRowCircle.start
  ])
  horizontal(negativeRowGuide)
  horizontalDistance([ORIGIN, negativeRowGuide.start]) == holeCenterFromBend
  verticalDistance([ORIGIN, negativeRowGuide.start]) == -holeRowOffset
  diameter(negativeRowCircle) == holeDiameter

  positiveRowCircle = circle(start = [var 32.5mm, var 10mm], center = [var 30mm, var 10mm])
  positiveRowGuide = line(start = [var 30mm, var 10mm], end = [var 32.5mm, var 10mm], construction = true)
  coincident([
    positiveRowGuide.start,
    positiveRowCircle.center
  ])
  coincident([
    positiveRowGuide.end,
    positiveRowCircle.start
  ])
  horizontal(positiveRowGuide)
  horizontalDistance([ORIGIN, positiveRowGuide.start]) == holeCenterFromBend
  verticalDistance([ORIGIN, positiveRowGuide.start]) == holeRowOffset
  diameter(positiveRowCircle) == holeDiameter
}

horizontalHoleRegionNegative = region(point = [30mm, -10mm], sketch = horizontalHoleSketch)
horizontalHoleRegionPositive = region(point = [30mm, 10mm], sketch = horizontalHoleSketch)
horizontalHoleCutterNegative = extrude(
  horizontalHoleRegionNegative,
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
horizontalHoleCutterPositive = extrude(
  horizontalHoleRegionPositive,
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
hide(horizontalHoleSketch)

verticalHoleSketch = sketch(on = YZ) {
  negativeRowCircle = circle(start = [var -7.5mm, var 30mm], center = [var -10mm, var 30mm])
  negativeRowGuide = line(start = [var -10mm, var 30mm], end = [var -7.5mm, var 30mm], construction = true)
  coincident([
    negativeRowGuide.start,
    negativeRowCircle.center
  ])
  coincident([
    negativeRowGuide.end,
    negativeRowCircle.start
  ])
  horizontal(negativeRowGuide)
  horizontalDistance([ORIGIN, negativeRowGuide.start]) == -holeRowOffset
  verticalDistance([ORIGIN, negativeRowGuide.start]) == holeCenterFromBend
  diameter(negativeRowCircle) == holeDiameter

  positiveRowCircle = circle(start = [var 12.5mm, var 30mm], center = [var 10mm, var 30mm])
  positiveRowGuide = line(start = [var 10mm, var 30mm], end = [var 12.5mm, var 30mm], construction = true)
  coincident([
    positiveRowGuide.start,
    positiveRowCircle.center
  ])
  coincident([
    positiveRowGuide.end,
    positiveRowCircle.start
  ])
  horizontal(positiveRowGuide)
  horizontalDistance([ORIGIN, positiveRowGuide.start]) == holeRowOffset
  verticalDistance([ORIGIN, positiveRowGuide.start]) == holeCenterFromBend
  diameter(positiveRowCircle) == holeDiameter
}

verticalHoleRegionNegative = region(point = [-10mm, 30mm], sketch = verticalHoleSketch)
verticalHoleRegionPositive = region(point = [10mm, 30mm], sketch = verticalHoleSketch)
verticalHoleCutterNegative = extrude(
  verticalHoleRegionNegative,
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
verticalHoleCutterPositive = extrude(
  verticalHoleRegionPositive,
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
hide(verticalHoleSketch)

finishedBracket = subtract(
  [bracketBlank],
  tools = [
    horizontalHoleCutterNegative,
    horizontalHoleCutterPositive,
    verticalHoleCutterNegative,
    verticalHoleCutterPositive
  ],
)

aluminumBracket = appearance(
  [finishedBracket],
  color = "#b9bec4",
  roughness = 32,
  metalness = 82,
)
