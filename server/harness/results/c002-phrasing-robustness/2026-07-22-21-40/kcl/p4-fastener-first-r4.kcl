/*
Generated by Text-to-CAD:
A 50mm x 50mm x 2mm aluminum plate that accepts four M5 flat-head countersunk screws sitting flush with the surface, one screw near each corner with its center 10mm from both adjacent edges
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateWidth = 50mm
plateHeight = 50mm
plateThickness = 2mm
holeInset = 10mm
holePitch = plateWidth - (2 * holeInset)
cornerOffset = plateWidth / 2 - holeInset
m5ClearanceDiameter = 5.5mm
countersinkDiameter = 10mm
cutOverlap = 0.2mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)

countersinkProfile = sketch(on = XZ) {
  axisEdge = line(start = [var 0mm, var -1.25mm], end = [var 0mm, var 1.2mm])
  topEdge = line(start = [var 0mm, var 1.2mm], end = [var 5.2mm, var 1.2mm])
  taperEdge = line(start = [var 5.2mm, var 1.2mm], end = [var 2.75mm, var -1.25mm])
  bottomEdge = line(start = [var 2.75mm, var -1.25mm], end = [var 0mm, var -1.25mm])

  coincident([axisEdge.end, topEdge.start])
  coincident([topEdge.end, taperEdge.start])
  coincident([taperEdge.end, bottomEdge.start])
  coincident([bottomEdge.end, axisEdge.start])
  vertical(axisEdge)
  horizontal(topEdge)
  horizontal(bottomEdge)
  horizontalDistance([axisEdge.start, ORIGIN]) == 0mm
  verticalDistance([axisEdge.start, ORIGIN]) == (countersinkDiameter - m5ClearanceDiameter) / 2 - (plateThickness / 2)
  verticalDistance([axisEdge.start, axisEdge.end]) == (countersinkDiameter - m5ClearanceDiameter) / 2 + cutOverlap
  horizontalDistance([axisEdge.end, topEdge.end]) == countersinkDiameter / 2 + cutOverlap
  horizontalDistance([bottomEdge.end, bottomEdge.start]) == m5ClearanceDiameter / 2
}

countersinkRegion = region(point = [2mm, 0mm], sketch = countersinkProfile)
countersinkBlank = revolve(countersinkRegion, axis = Y)

bottomRightCutter = clone(countersinkBlank)
  |> translate(x = cornerOffset, y = -cornerOffset, global = true)
topLeftCutter = clone(countersinkBlank)
  |> translate(x = -cornerOffset, y = cornerOffset, global = true)
topRightCutter = clone(countersinkBlank)
  |> translate(x = cornerOffset, y = cornerOffset, global = true)
bottomLeftCutter = countersinkBlank
  |> translate(x = -cornerOffset, y = -cornerOffset, global = true)

plateCutBottomLeft = subtract(plateBlank, tools = bottomLeftCutter)
plateCutBottomRight = subtract(plateCutBottomLeft, tools = bottomRightCutter)
plateCutTopLeft = subtract(plateCutBottomRight, tools = topLeftCutter)
plateCut = subtract(plateCutTopLeft, tools = topRightCutter)

aluminumPlate = appearance(
  plateCut,
  color = "#c7c9cc",
  metalness = 88,
  roughness = 30,
)

hide(plateSketch)
hide(countersinkProfile)
