/*
Generated by Text-to-CAD:
A 100mm x 20mm x 2mm aluminum strip with six 5mm diameter holes in a single row along the centerline, the first hole center 10mm from the left edge and the holes spaced 16mm apart
*/
@settings(defaultLengthUnit = mm, experimentalFeatures = allow, kclVersion = 2.0)

stripLength = 100mm
stripWidth = 20mm
stripThickness = 2mm
holeDiameter = 5mm
firstHoleOffset = 10mm
holeSpacing = 16mm

stripProfile = sketch(on = XY) {
  bottomEdge = line(start = [var 0mm, var 0mm], end = [var 100mm, var 0mm])
  rightEdge = line(start = [var 100mm, var 0mm], end = [var 100mm, var 20mm])
  topEdge = line(start = [var 100mm, var 20mm], end = [var 0mm, var 20mm])
  leftEdge = line(start = [var 0mm, var 20mm], end = [var 0mm, var 0mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  fixed([bottomEdge.start, [0mm, 0mm]])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == stripLength
  distance([rightEdge.start, rightEdge.end]) == stripWidth

  holeOne = circle(start = [var 12.5mm, var 10mm], center = [var 10mm, var 10mm])
  holeTwo = circle(start = [var 28.5mm, var 10mm], center = [var 26mm, var 10mm])
  holeThree = circle(start = [var 44.5mm, var 10mm], center = [var 42mm, var 10mm])
  holeFour = circle(start = [var 60.5mm, var 10mm], center = [var 58mm, var 10mm])
  holeFive = circle(start = [var 76.5mm, var 10mm], center = [var 74mm, var 10mm])
  holeSix = circle(start = [var 92.5mm, var 10mm], center = [var 90mm, var 10mm])

  horizontalDistance([ORIGIN, holeOne.center]) == firstHoleOffset
  horizontalDistance([ORIGIN, holeTwo.center]) == firstHoleOffset + holeSpacing
  horizontalDistance([ORIGIN, holeThree.center]) == firstHoleOffset + 2 * holeSpacing
  horizontalDistance([ORIGIN, holeFour.center]) == firstHoleOffset + 3 * holeSpacing
  horizontalDistance([ORIGIN, holeFive.center]) == firstHoleOffset + 4 * holeSpacing
  horizontalDistance([ORIGIN, holeSix.center]) == firstHoleOffset + 5 * holeSpacing
  verticalDistance([ORIGIN, holeOne.center]) == stripWidth / 2
  verticalDistance([ORIGIN, holeTwo.center]) == stripWidth / 2
  verticalDistance([ORIGIN, holeThree.center]) == stripWidth / 2
  verticalDistance([ORIGIN, holeFour.center]) == stripWidth / 2
  verticalDistance([ORIGIN, holeFive.center]) == stripWidth / 2
  verticalDistance([ORIGIN, holeSix.center]) == stripWidth / 2
  diameter(holeOne) == holeDiameter
  diameter(holeTwo) == holeDiameter
  diameter(holeThree) == holeDiameter
  diameter(holeFour) == holeDiameter
  diameter(holeFive) == holeDiameter
  diameter(holeSix) == holeDiameter
  verticalDistance([holeOne.center, holeOne.start]) == 0mm
  verticalDistance([holeTwo.center, holeTwo.start]) == 0mm
  verticalDistance([holeThree.center, holeThree.start]) == 0mm
  verticalDistance([holeFour.center, holeFour.start]) == 0mm
  verticalDistance([holeFive.center, holeFive.start]) == 0mm
  verticalDistance([holeSix.center, holeSix.start]) == 0mm
}

stripRegion = region(point = [5mm, 5mm], sketch = stripProfile)
aluminumStrip = extrude(stripRegion, length = stripThickness)
  |> appearance(color = "#b9c1c8", metalness = 85, roughness = 28)
