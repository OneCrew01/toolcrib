/*
Generated by Text-to-CAD:
Two aluminum parts: a panel 60mm x 60mm x 3mm with a square 30mm x 30mm opening through its center, and a separate square insert 29.7mm x 29.7mm x 3mm that fits into the opening and sits flush with the panel front face, leaving 0.15mm clearance per side. Chamfer the lead-in edges of the opening and the insert 0.5mm. Color the panel dark gray and the insert orange.
*/
@settings(defaultLengthUnit = mm)

panelSize = 60mm
panelThickness = 3mm
openingSize = 30mm
sideClearance = 0.15mm
insertSize = openingSize - (2 * sideClearance)
leadInChamfer = 0.5mm
cutterExtension = 0.1mm
openingChamferStartZ = panelThickness - leadInChamfer
openingChamferEndZ = panelThickness + cutterExtension
openingChamferEndSize = openingSize + 2 * (leadInChamfer + cutterExtension)
insertLeadSize = insertSize - (2 * leadInChamfer)

panelProfile = sketch(on = XY) {
  bottom = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  right = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  top = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  left = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == -panelSize / 2
  verticalDistance([ORIGIN, bottom.start]) == -panelSize / 2
  horizontalDistance([bottom.start, bottom.end]) == panelSize
  verticalDistance([right.start, right.end]) == panelSize
}
panelRegion = region(point = [0mm, 0mm], sketch = panelProfile)
panelRaw = extrude(panelRegion, length = panelThickness)

openingCorePlane = offsetPlane(XY, offset = -cutterExtension)
openingCoreProfile = sketch(on = openingCorePlane) {
  bottom = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  right = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  top = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  left = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == -openingSize / 2
  verticalDistance([ORIGIN, bottom.start]) == -openingSize / 2
  horizontalDistance([bottom.start, bottom.end]) == openingSize
  verticalDistance([right.start, right.end]) == openingSize
}
openingCoreRegion = region(point = [0mm, 0mm], sketch = openingCoreProfile)
openingCore = extrude(openingCoreRegion, length = panelThickness + 2 * cutterExtension)

openingChamferLowerPlane = offsetPlane(XY, offset = openingChamferStartZ)
openingChamferLowerProfile = sketch(on = openingChamferLowerPlane) {
  bottom = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  right = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  top = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  left = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == -openingSize / 2
  verticalDistance([ORIGIN, bottom.start]) == -openingSize / 2
  horizontalDistance([bottom.start, bottom.end]) == openingSize
  verticalDistance([right.start, right.end]) == openingSize
}
openingChamferLowerRegion = region(point = [0mm, 0mm], sketch = openingChamferLowerProfile)

openingChamferUpperPlane = offsetPlane(XY, offset = openingChamferEndZ)
openingChamferUpperProfile = sketch(on = openingChamferUpperPlane) {
  bottom = line(start = [var -15.6mm, var -15.6mm], end = [var 15.6mm, var -15.6mm])
  right = line(start = [var 15.6mm, var -15.6mm], end = [var 15.6mm, var 15.6mm])
  top = line(start = [var 15.6mm, var 15.6mm], end = [var -15.6mm, var 15.6mm])
  left = line(start = [var -15.6mm, var 15.6mm], end = [var -15.6mm, var -15.6mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == -openingChamferEndSize / 2
  verticalDistance([ORIGIN, bottom.start]) == -openingChamferEndSize / 2
  horizontalDistance([bottom.start, bottom.end]) == openingChamferEndSize
  verticalDistance([right.start, right.end]) == openingChamferEndSize
}
openingChamferUpperRegion = region(point = [0mm, 0mm], sketch = openingChamferUpperProfile)
openingLeadIn = loft(
  [
    openingChamferLowerRegion,
    openingChamferUpperRegion
  ],
  vDegree = 1,
)

panelCut = subtract(panelRaw, tools = [openingCore, openingLeadIn])
panel = panelCut
  |> appearance(color = "#3f454a", roughness = 34, metalness = 82)

insertBottomProfile = sketch(on = XY) {
  bottom = line(start = [var -14.35mm, var -14.35mm], end = [var 14.35mm, var -14.35mm])
  right = line(start = [var 14.35mm, var -14.35mm], end = [var 14.35mm, var 14.35mm])
  top = line(start = [var 14.35mm, var 14.35mm], end = [var -14.35mm, var 14.35mm])
  left = line(start = [var -14.35mm, var 14.35mm], end = [var -14.35mm, var -14.35mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == -insertLeadSize / 2
  verticalDistance([ORIGIN, bottom.start]) == -insertLeadSize / 2
  horizontalDistance([bottom.start, bottom.end]) == insertLeadSize
  verticalDistance([right.start, right.end]) == insertLeadSize
}
insertBottomRegion = region(point = [0mm, 0mm], sketch = insertBottomProfile)

insertShoulderPlane = offsetPlane(XY, offset = leadInChamfer)
insertShoulderProfile = sketch(on = insertShoulderPlane) {
  bottom = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  right = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  top = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  left = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == -insertSize / 2
  verticalDistance([ORIGIN, bottom.start]) == -insertSize / 2
  horizontalDistance([bottom.start, bottom.end]) == insertSize
  verticalDistance([right.start, right.end]) == insertSize
}
insertShoulderRegion = region(point = [0mm, 0mm], sketch = insertShoulderProfile)

insertTopPlane = offsetPlane(XY, offset = panelThickness)
insertTopProfile = sketch(on = insertTopPlane) {
  bottom = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  right = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  top = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  left = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == -insertSize / 2
  verticalDistance([ORIGIN, bottom.start]) == -insertSize / 2
  horizontalDistance([bottom.start, bottom.end]) == insertSize
  verticalDistance([right.start, right.end]) == insertSize
}
insertTopRegion = region(point = [0mm, 0mm], sketch = insertTopProfile)

insert = loft(
  [
    insertBottomRegion,
    insertShoulderRegion,
    insertTopRegion
  ],
  vDegree = 1,
)
  |> appearance(color = "#f28c28", roughness = 30, metalness = 78)

hide(panelProfile)
hide(openingCoreProfile)
hide(openingChamferLowerProfile)
hide(openingChamferUpperProfile)
hide(insertBottomProfile)
hide(insertShoulderProfile)
hide(insertTopProfile)

parts = [panel, insert]
