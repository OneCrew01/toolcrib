/*
Generated by Text-to-CAD:
50mm square 2mm aluminum plate, four countersunk 5mm corner holes 10mm from the edges
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateSize = 50mm
plateThickness = 2mm
holeEdgeInset = 10mm
holePitch = plateSize - (2 * holeEdgeInset)
throughHoleDiameter = 5mm
countersinkDiameter = 9mm
cutterOverlap = 0.1mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  distance([bottomEdge.start, bottomEdge.end]) == plateSize
  distance([rightEdge.start, rightEdge.end]) == plateSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)
hiddenPlateSketch = hide(plateSketch)

countersinkProfile = sketch(on = XZ) {
  axisEdge = line(start = [var -15mm, var -0.1mm], end = [var -15mm, var 2.1mm])
  topRadial = line(start = [var -15mm, var 2.1mm], end = [var -10.4mm, var 2.1mm])
  taperEdge = line(start = [var -10.4mm, var 2.1mm], end = [var -12.6mm, var -0.1mm])
  bottomRadial = line(start = [var -12.6mm, var -0.1mm], end = [var -15mm, var -0.1mm])

  coincident([axisEdge.end, topRadial.start])
  coincident([topRadial.end, taperEdge.start])
  coincident([taperEdge.end, bottomRadial.start])
  coincident([bottomRadial.end, axisEdge.start])

  vertical(axisEdge)
  horizontal(topRadial)
  horizontal(bottomRadial)

  distance([axisEdge.start, axisEdge.end]) == plateThickness + 2 * cutterOverlap
  distance([topRadial.start, topRadial.end]) == countersinkDiameter / 2 + cutterOverlap
  distance([bottomRadial.start, bottomRadial.end]) == throughHoleDiameter / 2 - cutterOverlap
  horizontalDistance([axisEdge.start, ORIGIN]) == plateSize / 2 - holeEdgeInset
  verticalDistance([axisEdge.start, ORIGIN]) == cutterOverlap
}

countersinkRegion = region(point = [-13mm, 1mm], sketch = countersinkProfile)
countersinkSeed = revolve(countersinkRegion, axis = countersinkProfile.axisEdge)
  |> translate(y = -(plateSize / 2 - holeEdgeInset), global = true)

countersinkRow = patternLinear3d(
  countersinkSeed,
  instances = 2,
  distance = holePitch,
  axis = X,
)
countersinkCutters = patternLinear3d(
  countersinkRow,
  instances = 2,
  distance = holePitch,
  axis = Y,
)

finishedPlate = subtract(plateBlank, tools = countersinkCutters)
  |> appearance(color = "#c9cdd1", metalness = 85, roughness = 28)
hiddenCountersinkProfile = hide(countersinkProfile)
