// 78-WAY HD HARNESS DATA — the wire list. EDIT THIS FILE.
//
// Same rule as the 9-way: a contact exists only where a wire is listed.
// With 78 cavities and 22 wires, the unpopulated majority is the point —
// a real GI 275 or GDU connector is rarely fully loaded.
//
// [C] Approved wire: MIL-W-22759/16, /18, /34; shielded MIL-C-27500.
// [C] MIL-W-22759/18 is RECOMMENDED for high-density connectors — thinner
//     insulation is far more compatible with HD contact spacing. Every
//     22 AWG entry below assumes /18.
// [C] Signal min 24 AWG; load-carrying min 22 AWG (GFC 500 rule).
// [C] Config module wiring always 28 AWG.
// [C] Size 22D contacts (M39029/58-360) accept 22-28 AWG — correct for HD.

@settings(defaultLengthUnit = in, kclVersion = 2.0)

export wireList78 = [
  { cav = 1, awg = 22, colour = "#c62828", sig = "AIRCRAFT PWR 1" },
  { cav = 2, awg = 22, colour = "#c62828", sig = "AIRCRAFT PWR 2" },
  { cav = 3, awg = 22, colour = "#212121", sig = "PWR GND 1" },
  { cav = 4, awg = 22, colour = "#212121", sig = "PWR GND 2" },
