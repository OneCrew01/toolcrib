/*
Generated by Text-to-CAD:
A 50mm x 50mm x 2mm aluminum plate with four 5mm diameter through holes, one near each corner, each hole center 10mm from both adjacent edges, each hole counterbored 9mm diameter by 1mm deep
*/
@settings(defaultLengthUnit = mm, kclVersion = 1.0, experimentalFeatures = allow)

plateLength = 50mm
plateWidth = 50mm
plateThickness = 2mm
holeDiameter = 5mm
counterboreDiameter = 9mm
counterboreDepth = 1mm
holeEdgeInset = 10mm
holePitchX = plateLength - (2 * holeEdgeInset)
holePitchY = plateWidth - (2 * holeEdgeInset)
cutOverlap = 1mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateLength
  distance([rightEdge.start, rightEdge.end]) == plateWidth
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateLength / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
}
plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)

throughHoleSketch = sketch(on = XY) {
  throughHoleCircle = circle(start = [var -12.5mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([
    throughHoleCircle.center,
    throughHoleCircle.start
  ])
  horizontalDistance([throughHoleCircle.center, ORIGIN]) == plateLength / 2 - holeEdgeInset
  verticalDistance([throughHoleCircle.center, ORIGIN]) == plateWidth / 2 - holeEdgeInset
  diameter(throughHoleCircle) == holeDiameter
}
throughHoleRegion = region(point = [-15mm, -15mm], sketch = throughHoleSketch)
throughHoleSeed = extrude(
  throughHoleRegion,
  length = plateThickness + 2 * cutOverlap,
  symmetric = true,
  method = NEW,
)
throughHoleRow = patternLinear3d(
  throughHoleSeed,
  instances = 2,
  distance = holePitchX,
  axis = X,
)
throughHoleCutters = patternLinear3d(
  throughHoleRow,
  instances = 2,
  distance = holePitchY,
  axis = Y,
)
plateDrilled = subtract(plateBlank, tools = throughHoleCutters)

counterboreSketch = sketch(on = XY) {
  counterboreCircle = circle(start = [var -10.5mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([
    counterboreCircle.center,
    counterboreCircle.start
  ])
  horizontalDistance([counterboreCircle.center, ORIGIN]) == plateLength / 2 - holeEdgeInset
  verticalDistance([counterboreCircle.center, ORIGIN]) == plateWidth / 2 - holeEdgeInset
  diameter(counterboreCircle) == counterboreDiameter
}
counterboreRegion = region(point = [-15mm, -15mm], sketch = counterboreSketch)
counterboreSeed = extrude(counterboreRegion, length = counterboreDepth + cutOverlap, method = NEW)
  |> translate(z = plateThickness - counterboreDepth, global = true)
counterboreRow = patternLinear3d(
  counterboreSeed,
  instances = 2,
  distance = holePitchX,
  axis = X,
)
counterboreCutters = patternLinear3d(
  counterboreRow,
  instances = 2,
  distance = holePitchY,
  axis = Y,
)
plateCounterbored = subtract(plateDrilled, tools = counterboreCutters)

hide(plateSketch)
hide(throughHoleSketch)
hide(counterboreSketch)

finishedPlate = appearance(
  plateCounterbored,
  color = "#b9bec4",
  metalness = 88,
  roughness = 28,
)
