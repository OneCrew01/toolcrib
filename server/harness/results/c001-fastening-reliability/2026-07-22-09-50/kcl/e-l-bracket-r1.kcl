/*
Generated by Text-to-CAD:
An L-shaped aluminum bracket, 2mm thick, with two rectangular legs each 40mm long and 40mm wide meeting at 90 degrees, with two 5mm diameter holes in each leg, each hole center 10mm from the free end of its leg and 10mm from the nearest side edge
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

legLength = 40
bracketWidth = 40
sheetThickness = 2
holeDiameter = 5
holeEdgeOffset = 10
cutterLength = sheetThickness + 4

bracketProfile = sketch(on = XZ) {
  outerHorizontal = line(start = [var 0mm, var 0mm], end = [var 40mm, var 0mm])
  horizontalTip = line(start = [var 40mm, var 0mm], end = [var 40mm, var 2mm])
  innerHorizontal = line(start = [var 40mm, var 2mm], end = [var 2mm, var 2mm])
  innerVertical = line(start = [var 2mm, var 2mm], end = [var 2mm, var 40mm])
  verticalTip = line(start = [var 2mm, var 40mm], end = [var 0mm, var 40mm])
  outerVertical = line(start = [var 0mm, var 40mm], end = [var 0mm, var 0mm])

  coincident([
    outerHorizontal.end,
    horizontalTip.start
  ])
  coincident([
    horizontalTip.end,
    innerHorizontal.start
  ])
  coincident([
    innerHorizontal.end,
    innerVertical.start
  ])
  coincident([innerVertical.end, verticalTip.start])
  coincident([verticalTip.end, outerVertical.start])
  coincident([
    outerVertical.end,
    outerHorizontal.start
  ])

  horizontal(outerHorizontal)
  vertical(horizontalTip)
  horizontal(innerHorizontal)
  vertical(innerVertical)
  horizontal(verticalTip)
  vertical(outerVertical)

  coincident([outerHorizontal.start, ORIGIN])
  horizontalDistance([
  outerHorizontal.start,
  outerHorizontal.end
]) == legLength
  verticalDistance([outerHorizontal.end, horizontalTip.end]) == sheetThickness
  horizontalDistance([
  innerHorizontal.end,
  innerHorizontal.start
]) == legLength - sheetThickness
  verticalDistance([innerHorizontal.end, innerVertical.end]) == legLength - sheetThickness
  horizontalDistance([verticalTip.end, verticalTip.start]) == sheetThickness
  verticalDistance([outerVertical.end, outerVertical.start]) == legLength
}

bracketBlank = extrude(region(point = [20mm, 1mm], sketch = bracketProfile), length = bracketWidth, symmetric = true)
bracketProfileHidden = hide(bracketProfile)

horizontalHoleProfile = sketch(on = XY) {
  holeCircle = circle(start = [var 2.5mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([holeCircle.center, ORIGIN])
  horizontal([holeCircle.start, holeCircle.center])
  diameter(holeCircle) == holeDiameter
}

horizontalHoleNear = extrude(
  region(point = [0mm, 0mm], sketch = horizontalHoleProfile),
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
  |> translate(
       xyz = [
         legLength - holeEdgeOffset,
         -bracketWidth / 2 + holeEdgeOffset,
         sheetThickness / 2
       ],
       global = true,
     )
horizontalHoleFar = extrude(
  region(point = [0mm, 0mm], sketch = horizontalHoleProfile),
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
  |> translate(
       xyz = [
         legLength - holeEdgeOffset,
         bracketWidth / 2 - holeEdgeOffset,
         sheetThickness / 2
       ],
       global = true,
     )
horizontalHoleProfileHidden = hide(horizontalHoleProfile)

verticalHoleProfile = sketch(on = YZ) {
  holeCircle = circle(start = [var 2.5mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([holeCircle.center, ORIGIN])
  horizontal([holeCircle.start, holeCircle.center])
  diameter(holeCircle) == holeDiameter
}

verticalHoleNear = extrude(
  region(point = [0mm, 0mm], sketch = verticalHoleProfile),
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
  |> translate(
       xyz = [
         sheetThickness / 2,
         -bracketWidth / 2 + holeEdgeOffset,
         legLength - holeEdgeOffset
       ],
       global = true,
     )
verticalHoleFar = extrude(
  region(point = [0mm, 0mm], sketch = verticalHoleProfile),
  length = cutterLength,
  symmetric = true,
  method = NEW,
)
  |> translate(
       xyz = [
         sheetThickness / 2,
         bracketWidth / 2 - holeEdgeOffset,
         legLength - holeEdgeOffset
       ],
       global = true,
     )
verticalHoleProfileHidden = hide(verticalHoleProfile)

finishedBracket = subtract(
  [bracketBlank],
  tools = [
    horizontalHoleNear,
    horizontalHoleFar,
    verticalHoleNear,
    verticalHoleFar
  ],
)
  |> appearance(color = "#B8BEC6", metalness = 88, roughness = 32)
