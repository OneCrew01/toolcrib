/*
Generated by Text-to-CAD:
Flat aluminum plate, 50 mm square and 2 mm thick. Drill four 5 mm holes at the corners, 10 mm in from each edge, and countersink them at 100 degrees so flat-head screws sit flush
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateSize = 50mm
plateThickness = 2mm
holeDiameter = 5mm
holeInset = 10mm
holePitch = plateSize - (2 * holeInset)
countersinkAngle = 100deg
countersinkDiameter = 9.5mm
countersinkRadius = countersinkDiameter / 2
holeRadius = holeDiameter / 2
countersinkDepth = (countersinkRadius - holeRadius) / tan(countersinkAngle / 2)
countersinkStartZ = plateThickness - countersinkDepth
cutterOverlap = 0.2mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  horizontalDistance([bottomEdge.start, bottomEdge.end]) == plateSize
  verticalDistance([rightEdge.start, rightEdge.end]) == plateSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)
hiddenPlateSketch = hide(plateSketch)

holeCutterSketch = sketch(on = XZ) {
  axisEdge = line(start = [var 0mm, var -0.2mm], end = [var 0mm, var 2.2mm])
  topEdge = line(start = [var 0mm, var 2.2mm], end = [var 4.75mm, var 2.2mm])
  topRim = line(start = [var 4.75mm, var 2.2mm], end = [var 4.75mm, var 2mm])
  countersinkSlope = line(start = [var 4.75mm, var 2mm], end = [var 2.5mm, var 0.112mm])
  boreWall = line(start = [var 2.5mm, var 0.112mm], end = [var 2.5mm, var -0.2mm])
  bottomEdge = line(start = [var 2.5mm, var -0.2mm], end = [var 0mm, var -0.2mm])

  coincident([axisEdge.end, topEdge.start])
  coincident([topEdge.end, topRim.start])
  coincident([topRim.end, countersinkSlope.start])
  coincident([countersinkSlope.end, boreWall.start])
  coincident([boreWall.end, bottomEdge.start])
  coincident([bottomEdge.end, axisEdge.start])
  vertical(axisEdge)
  horizontal(topEdge)
  vertical(topRim)
  vertical(boreWall)
  horizontal(bottomEdge)
  vertical([axisEdge.start, ORIGIN])
  verticalDistance([axisEdge.start, ORIGIN]) == cutterOverlap
  verticalDistance([axisEdge.start, axisEdge.end]) == plateThickness + 2 * cutterOverlap
  horizontalDistance([axisEdge.end, topEdge.end]) == countersinkRadius
  verticalDistance([topRim.end, topRim.start]) == cutterOverlap
  horizontalDistance([
  countersinkSlope.end,
  countersinkSlope.start
]) == countersinkRadius - holeRadius
  verticalDistance([boreWall.end, boreWall.start]) == countersinkStartZ + cutterOverlap
}

holeCutterRegion = region(point = [1mm, 1mm], sketch = holeCutterSketch)
holeCutterSeed = revolve(holeCutterRegion, axis = Y)
  |> translate(x = -15mm, y = -15mm, global = true)
holeCutters = patternLinear3d(
  patternLinear3d(
    holeCutterSeed,
    instances = 2,
    distance = holePitch,
    axis = X,
  ),
  instances = 2,
  distance = holePitch,
  axis = Y,
)
countersunkPlate = subtract(plateBlank, tools = holeCutters)
hiddenHoleCutterSketch = hide(holeCutterSketch)

finishedPlate = appearance(
  countersunkPlate,
  color = "#b9bec3",
  metalness = 88,
  roughness = 28,
)
