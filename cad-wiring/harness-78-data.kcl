  { cav = 18, awg = 24, colour = "#2e7d32", sig = "ARINC 429 IN 1A" },
  { cav = 19, awg = 24, colour = "#f9a825", sig = "ARINC 429 IN 1B" },
  { cav = 26, awg = 24, colour = "#6a1b9a", sig = "DISCRETE IN 1" },
  { cav = 30, awg = 24, colour = "#2e7d32", sig = "ARINC 429 OUT A" },
  { cav = 31, awg = 24, colour = "#f9a825", sig = "ARINC 429 OUT B" },
  { cav = 36, awg = 28, colour = "#00838f", sig = "CONFIG MOD DATA" },
  { cav = 37, awg = 28, colour = "#4e342e", sig = "CONFIG MOD CLK" },
  { cav = 44, awg = 24, colour = "#6a1b9a", sig = "DISCRETE IN 2" },
