/*
Generated by Text-to-CAD:
50mm square 2mm aluminum plate, four countersunk 5mm corner holes 10mm from the edges
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateSize = 50mm
plateThickness = 2mm
holeDiameter = 5mm
holeEdgeInset = 10mm
holeCenterOffset = plateSize / 2 - holeEdgeInset
countersinkDiameter = 8mm
countersinkDepth = (countersinkDiameter - holeDiameter) / 2
cutOverlap = 0.1mm
holePitch = plateSize - (2 * holeEdgeInset)

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateSize
  distance([rightEdge.start, rightEdge.end]) == plateSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)

throughHoleSketch = sketch(on = offsetPlane(XY, offset = -cutOverlap)) {
  holeCircle = circle(start = [var -12.5mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([holeCircle.center, holeCircle.start])
  horizontalDistance([holeCircle.center, ORIGIN]) == holeCenterOffset
  verticalDistance([holeCircle.center, ORIGIN]) == holeCenterOffset
  diameter(holeCircle) == holeDiameter
}

throughHoleRegion = region(point = [-15mm, -15mm], sketch = throughHoleSketch)
throughHoleSeed = extrude(throughHoleRegion, length = plateThickness + 2 * cutOverlap, method = NEW)
throughHoleCutters = patternLinear3d(
  patternLinear3d(
    throughHoleSeed,
    instances = 2,
    distance = holePitch,
    axis = X,
  ),
  instances = 2,
  distance = holePitch,
  axis = Y,
)
plateDrilled = subtract(plateBlank, tools = throughHoleCutters)

countersinkBottomZ = plateThickness - countersinkDepth - cutOverlap
countersinkTopZ = plateThickness + cutOverlap
countersinkBottomDiameter = holeDiameter - (2 * cutOverlap)
countersinkTopDiameter = countersinkDiameter + 2 * cutOverlap

countersinkBottomSketch = sketch(on = offsetPlane(XY, offset = countersinkBottomZ)) {
  bottomCircle = circle(start = [var -12.6mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([
    bottomCircle.center,
    bottomCircle.start
  ])
  horizontalDistance([bottomCircle.center, ORIGIN]) == holeCenterOffset
  verticalDistance([bottomCircle.center, ORIGIN]) == holeCenterOffset
  diameter(bottomCircle) == countersinkBottomDiameter
}

countersinkTopSketch = sketch(on = offsetPlane(XY, offset = countersinkTopZ)) {
  topCircle = circle(start = [var -10.9mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([topCircle.center, topCircle.start])
  horizontalDistance([topCircle.center, ORIGIN]) == holeCenterOffset
  verticalDistance([topCircle.center, ORIGIN]) == holeCenterOffset
  diameter(topCircle) == countersinkTopDiameter
}

countersinkBottomRegion = region(point = [-15mm, -15mm], sketch = countersinkBottomSketch)
countersinkTopRegion = region(point = [-15mm, -15mm], sketch = countersinkTopSketch)
countersinkSeed = loft([
  countersinkBottomRegion,
  countersinkTopRegion
])
countersinkCutters = patternLinear3d(
  patternLinear3d(
    countersinkSeed,
    instances = 2,
    distance = holePitch,
    axis = X,
  ),
  instances = 2,
  distance = holePitch,
  axis = Y,
)
plateCountersunk = subtract(plateDrilled, tools = countersinkCutters)

hide(plateSketch)
hide(throughHoleSketch)
hide(countersinkBottomSketch)
hide(countersinkTopSketch)

finishedPlate = appearance(
  plateCountersunk,
  color = "#b9c2c9",
  metalness = 82,
  roughness = 32,
)
