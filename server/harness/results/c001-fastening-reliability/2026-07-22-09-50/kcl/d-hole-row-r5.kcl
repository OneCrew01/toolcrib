/*
Generated by Text-to-CAD:
A 100mm x 20mm x 2mm aluminum strip with six 5mm diameter holes in a single row along the centerline, the first hole center 10mm from the left edge and the holes spaced 16mm apart
*/
@settings(kclVersion = 2.0, defaultLengthUnit = mm)

stripLength = 100mm
stripWidth = 20mm
stripThickness = 2mm
holeDiameter = 5mm
firstHoleOffset = 10mm
holeSpacing = 16mm
holeCount = 6
cutterOverlap = 0.2mm

stripSketch = sketch(on = XY) {
  leftHalfGuide = line(start = [var 0mm, var 0mm], end = [var 0mm, var -10mm], construction = true)
  bottomEdge = line(start = [var 0mm, var -10mm], end = [var 100mm, var -10mm])
  rightEdge = line(start = [var 100mm, var -10mm], end = [var 100mm, var 10mm])
  topEdge = line(start = [var 100mm, var 10mm], end = [var 0mm, var 10mm])
  leftEdge = line(start = [var 0mm, var 10mm], end = [var 0mm, var -10mm])

  coincident([leftHalfGuide.start, ORIGIN])
  coincident([leftHalfGuide.end, bottomEdge.start])
  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  vertical(leftHalfGuide)
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)

  distance([leftHalfGuide.start, leftHalfGuide.end]) == stripWidth / 2
  distance([bottomEdge.start, bottomEdge.end]) == stripLength
  distance([rightEdge.start, rightEdge.end]) == stripWidth
}

stripRegion = region(point = [50mm, 0mm], sketch = stripSketch)
baseStrip = extrude(stripRegion, length = stripThickness)
hiddenStripSketch = hide(stripSketch)

holePlane = offsetPlane(XY, offset = -cutterOverlap)
holeSketch = sketch(on = holePlane) {
  centerGuide = line(start = [var 0mm, var 0mm], end = [var 10mm, var 0mm], construction = true)
  holeCircle = circle(start = [var 12.5mm, var 0mm], center = [var 10mm, var 0mm])

  coincident([centerGuide.start, ORIGIN])
  coincident([holeCircle.center, centerGuide.end])
  horizontal(centerGuide)
  horizontal([holeCircle.center, holeCircle.start])
  distance([centerGuide.start, centerGuide.end]) == firstHoleOffset
  diameter(holeCircle) == holeDiameter
}

holeRegion = region(point = [10mm, 0mm], sketch = holeSketch)
holeSeed = extrude(holeRegion, length = stripThickness + 2 * cutterOverlap, method = NEW)
holeCutters = patternLinear3d(
  holeSeed,
  instances = holeCount,
  distance = holeSpacing,
  axis = X,
)
hiddenHoleSketch = hide(holeSketch)

aluminumStrip = subtract(baseStrip, tools = holeCutters)
  |> appearance(color = "#b8bec5", metalness = 85, roughness = 32)
