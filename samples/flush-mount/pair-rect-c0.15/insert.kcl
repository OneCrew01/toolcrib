/*
ToolCRIB flush-mount pair — INSERT, rect with rear lip
Face sits FLUSH with the panel front. Body = opening - 2 x clearance per side.
Generated by generateFlushMountPair(). Edit the named parameters; the
geometry follows. Every derived value states its formula.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

openingWidth = 30mm  // the panel cutout this plugs into
openingHeight = 20mm
clearancePerSide = 0.15mm
panelThickness = 3mm
chamferAngle = 45deg
chamferDepth = 0.8mm
// insertWidth = openingWidth - 2 x clearancePerSide = 29.70mm
insertWidth = openingWidth - 2 * clearancePerSide
// insertHeight = openingHeight - 2 x clearancePerSide = 19.70mm
insertHeight = openingHeight - 2 * clearancePerSide
insertDepth = panelThickness  // flush: the insert face lands level with the panel face
lipOverhang = 2mm  // flange overhang per side behind the panel — the insert cannot fall through
lipThickness = 2mm  // flange thickness = overhang, by convention
flangeWidth = openingWidth + 2 * lipOverhang  // = 34.00mm
flangeHeight = openingHeight + 2 * lipOverhang  // = 24.00mm
plugDepth = lipThickness + insertDepth  // = 5.00mm total
cutOverlap = 1mm
chamferRun = 0.8mm  // chamferDepth x tan(chamferAngle) — the flare width on the entry face
chamferReach = 1.8mm  // chamferRun x (chamferDepth + cutOverlap) / chamferDepth — taper extended past the face
chamferBite = 0.35mm  // overshoot along the taper — keeps boolean cuts off coincident faces
wedgeLowZ = 3.85mm  // plugDepth - chamferDepth - chamferBite x chamferDepth / chamferRun
faceTopZ = plugDepth + cutOverlap
wedgeSpanY = insertHeight + 2 * chamferReach + 2mm
wedgeSpanX = insertWidth + 2 * chamferReach + 2mm

flangeSketch = sketch(on = XY) {
  s0 = line(start = [var -17mm, var -12mm], end = [var 17mm, var -12mm])
  s1 = line(start = [var 17mm, var -12mm], end = [var 17mm, var 12mm])
  s2 = line(start = [var 17mm, var 12mm], end = [var -17mm, var 12mm])
  s3 = line(start = [var -17mm, var 12mm], end = [var -17mm, var -12mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s2)
  vertical(s3)
  horizontalDistance([s0.start, ORIGIN]) == flangeWidth / 2
  horizontalDistance([ORIGIN, s1.start]) == flangeWidth / 2
  verticalDistance([s0.start, ORIGIN]) == flangeHeight / 2
  verticalDistance([ORIGIN, s2.start]) == flangeHeight / 2
}
flangeRegion = region(point = [0mm, 0mm], sketch = flangeSketch)
fullBlank = extrude(flangeRegion, length = plugDepth)
hide(flangeSketch)

ringBlankSketch = sketch(on = XY) {
  s0 = line(start = [var -18mm, var -13mm], end = [var 18mm, var -13mm])
  s1 = line(start = [var 18mm, var -13mm], end = [var 18mm, var 13mm])
  s2 = line(start = [var 18mm, var 13mm], end = [var -18mm, var 13mm])
  s3 = line(start = [var -18mm, var 13mm], end = [var -18mm, var -13mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s2)
  vertical(s3)
  horizontalDistance([s0.start, ORIGIN]) == flangeWidth / 2 + cutOverlap
  horizontalDistance([ORIGIN, s1.start]) == flangeWidth / 2 + cutOverlap
  verticalDistance([s0.start, ORIGIN]) == flangeHeight / 2 + cutOverlap
  verticalDistance([ORIGIN, s2.start]) == flangeHeight / 2 + cutOverlap
}
ringBlankRegion = region(point = [0mm, 0mm], sketch = ringBlankSketch)
ringBlankSolid = extrude(ringBlankRegion, length = insertDepth + 2 * cutOverlap, method = NEW)
  |> translate(z = lipThickness, global = true)
hide(ringBlankSketch)

bodyHoleSketch = sketch(on = XY) {
  s0 = line(start = [var -14.85mm, var -9.85mm], end = [var 14.85mm, var -9.85mm])
  s1 = line(start = [var 14.85mm, var -9.85mm], end = [var 14.85mm, var 9.85mm])
  s2 = line(start = [var 14.85mm, var 9.85mm], end = [var -14.85mm, var 9.85mm])
  s3 = line(start = [var -14.85mm, var 9.85mm], end = [var -14.85mm, var -9.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s2)
  vertical(s3)
  horizontalDistance([s0.start, ORIGIN]) == insertWidth / 2
  horizontalDistance([ORIGIN, s1.start]) == insertWidth / 2
  verticalDistance([s0.start, ORIGIN]) == insertHeight / 2
  verticalDistance([ORIGIN, s2.start]) == insertHeight / 2
}
bodyHoleRegion = region(point = [0mm, 0mm], sketch = bodyHoleSketch)
bodyHoleSolid = extrude(bodyHoleRegion, length = insertDepth + 4 * cutOverlap, method = NEW)
  |> translate(z = lipThickness - cutOverlap, global = true)
hide(bodyHoleSketch)

// The flange stays; everything above it outside the body goes.
ringCutter = subtract(ringBlankSolid, tools = [bodyHoleSolid])
plugCut1 = subtract(fullBlank, tools = [ringCutter])

wedgeEastSketch = sketch(on = XZ) {
  s0 = line(start = [var 15.2mm, var 3.85mm], end = [var 13.05mm, var 6mm])
  s1 = line(start = [var 13.05mm, var 6mm], end = [var 15.2mm, var 6mm])
  s2 = line(start = [var 15.2mm, var 6mm], end = [var 15.2mm, var 3.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([ORIGIN, s0.start]) == insertWidth / 2 + chamferBite
  horizontalDistance([ORIGIN, s1.start]) == insertWidth / 2 - chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeEastRegion = region(point = [14.4833mm, 5.2833mm], sketch = wedgeEastSketch)
wedgeEastCutter = extrude(wedgeEastRegion, length = wedgeSpanY, symmetric = true, method = NEW)
hide(wedgeEastSketch)

wedgeWestSketch = sketch(on = XZ) {
  s0 = line(start = [var -15.2mm, var 3.85mm], end = [var -13.05mm, var 6mm])
  s1 = line(start = [var -13.05mm, var 6mm], end = [var -15.2mm, var 6mm])
  s2 = line(start = [var -15.2mm, var 6mm], end = [var -15.2mm, var 3.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([s0.start, ORIGIN]) == insertWidth / 2 + chamferBite
  horizontalDistance([s1.start, ORIGIN]) == insertWidth / 2 - chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeWestRegion = region(point = [-14.4833mm, 5.2833mm], sketch = wedgeWestSketch)
wedgeWestCutter = extrude(wedgeWestRegion, length = wedgeSpanY, symmetric = true, method = NEW)
hide(wedgeWestSketch)

wedgeNorthSketch = sketch(on = YZ) {
  s0 = line(start = [var 10.2mm, var 3.85mm], end = [var 8.05mm, var 6mm])
  s1 = line(start = [var 8.05mm, var 6mm], end = [var 10.2mm, var 6mm])
  s2 = line(start = [var 10.2mm, var 6mm], end = [var 10.2mm, var 3.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([ORIGIN, s0.start]) == insertHeight / 2 + chamferBite
  horizontalDistance([ORIGIN, s1.start]) == insertHeight / 2 - chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeNorthRegion = region(point = [9.4833mm, 5.2833mm], sketch = wedgeNorthSketch)
wedgeNorthCutter = extrude(wedgeNorthRegion, length = wedgeSpanX, symmetric = true, method = NEW)
hide(wedgeNorthSketch)

wedgeSouthSketch = sketch(on = YZ) {
  s0 = line(start = [var -10.2mm, var 3.85mm], end = [var -8.05mm, var 6mm])
  s1 = line(start = [var -8.05mm, var 6mm], end = [var -10.2mm, var 6mm])
  s2 = line(start = [var -10.2mm, var 6mm], end = [var -10.2mm, var 3.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([s0.start, ORIGIN]) == insertHeight / 2 + chamferBite
  horizontalDistance([s1.start, ORIGIN]) == insertHeight / 2 - chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeSouthRegion = region(point = [-9.4833mm, 5.2833mm], sketch = wedgeSouthSketch)
wedgeSouthCutter = extrude(wedgeSouthRegion, length = wedgeSpanX, symmetric = true, method = NEW)
hide(wedgeSouthSketch)

plugCut2 = subtract(plugCut1, tools = [wedgeEastCutter])
plugCut3 = subtract(plugCut2, tools = [wedgeWestCutter])
plugCut4 = subtract(plugCut3, tools = [wedgeNorthCutter])
plugCut5 = subtract(plugCut4, tools = [wedgeSouthCutter])
finishedInsert = appearance(plugCut5, color = "#e07a2f", metalness = 5, roughness = 60)
