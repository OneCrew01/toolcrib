/*
Generated by Text-to-CAD:
A 50mm x 50mm x 2mm aluminum plate that accepts four M5 flat-head countersunk screws sitting flush with the surface, one screw near each corner with its center 10mm from both adjacent edges
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

plateLength = 50mm
plateWidth = 50mm
plateThickness = 2mm
holeEdgeInset = 10mm
holePitchX = plateLength - (2 * holeEdgeInset)
holePitchY = plateWidth - (2 * holeEdgeInset)
m5ClearanceDiameter = 5.5mm
countersinkDiameter = 10mm
countersinkExitDiameter = countersinkDiameter - (2 * plateThickness)
throughCutOverlap = 0.1mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateLength
  distance([rightEdge.start, rightEdge.end]) == plateWidth
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateLength / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)

throughHoleSketch = sketch(on = XY) {
  holeCircle = circle(start = [var -12.25mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([holeCircle.center, holeCircle.start])
  horizontalDistance([holeCircle.center, ORIGIN]) == plateLength / 2 - holeEdgeInset
  verticalDistance([holeCircle.center, ORIGIN]) == plateWidth / 2 - holeEdgeInset
  diameter(holeCircle) == m5ClearanceDiameter
}

throughHoleRegion = region(point = [-15mm, -15mm], sketch = throughHoleSketch)
throughHoleSeed = extrude(
  throughHoleRegion,
  length = plateThickness + 2 * throughCutOverlap,
  symmetric = true,
  method = NEW,
)
throughHoleCutters = patternLinear3d(
  patternLinear3d(
    throughHoleSeed,
    instances = 2,
    distance = holePitchX,
    axis = X,
  ),
  instances = 2,
  distance = holePitchY,
  axis = Y,
)
plateDrilled = subtract(plateBlank, tools = throughHoleCutters)

countersinkTopPlane = {
  origin = [-15mm, -15mm, plateThickness / 2],
  xAxis = [1, 0, 0],
  yAxis = [0, 1, 0]
}
countersinkBottomPlane = {
  origin = [-15mm, -15mm, -plateThickness / 2],
  xAxis = [1, 0, 0],
  yAxis = [0, 1, 0]
}

countersinkTopSketch = sketch(on = countersinkTopPlane) {
  topCircle = circle(start = [var 5mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([topCircle.center, ORIGIN])
  horizontal([topCircle.center, topCircle.start])
  diameter(topCircle) == countersinkDiameter
}

countersinkBottomSketch = sketch(on = countersinkBottomPlane) {
  bottomCircle = circle(start = [var 3mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([bottomCircle.center, ORIGIN])
  horizontal([
    bottomCircle.center,
    bottomCircle.start
  ])
  diameter(bottomCircle) == countersinkExitDiameter
}

countersinkTopRegion = region(point = [0mm, 0mm], sketch = countersinkTopSketch)
countersinkBottomRegion = region(point = [0mm, 0mm], sketch = countersinkBottomSketch)
countersinkSeed = loft([
  countersinkTopRegion,
  countersinkBottomRegion
])
countersinkCutters = patternLinear3d(
  patternLinear3d(
    countersinkSeed,
    instances = 2,
    distance = holePitchX,
    axis = X,
  ),
  instances = 2,
  distance = holePitchY,
  axis = Y,
)
plateCountersunk = subtract(plateDrilled, tools = countersinkCutters)

hide(plateSketch)
hide(throughHoleSketch)
hide(countersinkTopSketch)
hide(countersinkBottomSketch)

finishedPlate = appearance(
  plateCountersunk,
  color = "#c4c8cc",
  metalness = 88,
  roughness = 28,
)
