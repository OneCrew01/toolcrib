/*
Generated by Text-to-CAD:
A 50mm x 50mm x 2mm aluminum plate with four 5mm diameter holes, one near each corner, each hole center 10mm from both adjacent edges, each hole countersunk at 100 degrees to sit a flush flat-head screw
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

plateLength = 50mm
plateWidth = 50mm
plateThickness = 2mm
holeDiameter = 5mm
holeRadius = holeDiameter / 2
holeEdgeInset = 10mm
holeCenterOffset = plateLength / 2 - holeEdgeInset
holePitch = plateLength - (2 * holeEdgeInset)
countersinkAngle = 100deg
countersinkHalfAngle = countersinkAngle / 2
countersinkDiameter = 9.5mm
countersinkRadius = countersinkDiameter / 2
countersinkBottomRadius = holeRadius - 0.1mm
countersinkBottomZ = plateThickness - ((countersinkRadius - countersinkBottomRadius) / tan(countersinkHalfAngle))
countersinkTopOverlap = 0.2mm
countersinkExtendedRadius = countersinkRadius + countersinkTopOverlap * tan(countersinkHalfAngle)
cutOverlap = 1mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateLength
  distance([rightEdge.start, rightEdge.end]) == plateWidth
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateLength / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness, tagEnd = $plateTop)
hide(plateSketch)

throughHoleSketch = sketch(on = XY) {
  holeCircle = circle(start = [var -12.5mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([holeCircle.center, holeCircle.start])
  horizontalDistance([holeCircle.center, ORIGIN]) == holeCenterOffset
  verticalDistance([holeCircle.center, ORIGIN]) == holeCenterOffset
  diameter(holeCircle) == holeDiameter
}

throughHoleRegion = region(point = [-15mm, -15mm], sketch = throughHoleSketch)
throughHoleSeed = extrude(
  throughHoleRegion,
  length = plateThickness + 2 * cutOverlap,
  symmetric = true,
  method = NEW,
)
  |> translate(z = plateThickness / 2, global = true)
throughHoleRow = patternLinear3d(
  throughHoleSeed,
  instances = 2,
  distance = holePitch,
  axis = X,
)
throughHoleCutters = patternLinear3d(
  throughHoleRow,
  instances = 2,
  distance = holePitch,
  axis = Y,
)
hide(throughHoleSketch)

countersinkSketch = sketch(on = XZ) {
  axisEdge = line(start = [var 0mm, var 0.03mm], end = [var 0mm, var 2.2mm])
  topEdge = line(start = [var 0mm, var 2.2mm], end = [var 5mm, var 2.2mm])
  taperEdge = line(start = [var 5mm, var 2.2mm], end = [var 2.4mm, var 0.03mm])
  bottomEdge = line(start = [var 2.4mm, var 0.03mm], end = [var 0mm, var 0.03mm])

  coincident([axisEdge.end, topEdge.start])
  coincident([topEdge.end, taperEdge.start])
  coincident([taperEdge.end, bottomEdge.start])
  coincident([bottomEdge.end, axisEdge.start])
  vertical(axisEdge)
  horizontal(topEdge)
  horizontal(bottomEdge)
  vertical([axisEdge.start, ORIGIN])
  verticalDistance([ORIGIN, axisEdge.start]) == countersinkBottomZ
  verticalDistance([ORIGIN, axisEdge.end]) == plateThickness + countersinkTopOverlap
  distance([topEdge.start, topEdge.end]) == countersinkExtendedRadius
  distance([bottomEdge.start, bottomEdge.end]) == countersinkBottomRadius
}

countersinkRegion = region(point = [1mm, 1mm], sketch = countersinkSketch)
countersinkOriginCutter = revolve(countersinkRegion, axis = Y)
countersinkSeed = countersinkOriginCutter
  |> translate(x = -holeCenterOffset, y = -holeCenterOffset, global = true)
countersinkRow = patternLinear3d(
  countersinkSeed,
  instances = 2,
  distance = holePitch,
  axis = X,
)
countersinkCutters = patternLinear3d(
  countersinkRow,
  instances = 2,
  distance = holePitch,
  axis = Y,
)
hide(countersinkSketch)

plateCounter1 = subtract(plateBlank, tools = [countersinkCutters[0]])
plateCounter2 = subtract(plateCounter1, tools = [countersinkCutters[1]])
plateCounter3 = subtract(plateCounter2, tools = [countersinkCutters[2]])
plateCounter4 = subtract(plateCounter3, tools = [countersinkCutters[3]])
plateCountersunk = subtract(plateCounter4, tools = throughHoleCutters)

finishedPlate = appearance(
  plateCountersunk,
  color = "#c7ccd1",
  metalness = 88,
  roughness = 27,
)
