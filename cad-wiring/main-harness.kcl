// END-TO-END WIRE → CONTACT → CONNECTOR
// ToolCRIB · Zoo wiring benchmark · 2026-07-30
//
// Demonstrates: wire, exposed conductor, crimp barrel, contact, contact
// seated in a connector cavity, and pin protruding through the mating face.
//
// THE POINT OF THIS MODEL:
//   Contacts are generated by mapping over `wireList`. Cavities are generated
//   by mapping over `allCavities`. A cavity with no wire gets a hole and
//   nothing else. Edit harness-data.kcl and the populated set changes.
//
// Cavities 3, 6 and 8 carry no wire in the current data and must appear as
// empty holes.

@settings(defaultLengthUnit = in, kclVersion = 2.0)

import * from "parameters.kcl"
import * from "harness-data.kcl"

// ===================================================================
// 1 · SHELL FLANGE — the D-sub mounting flange with jackscrew holes
// ===================================================================
flangePlate = startSketchOn(offsetPlane(XY, offset = -flangeThk))
  |> startProfile(at = [-flangeW / 2, -flangeH / 2])
  |> line(end = [flangeW, 0])
  |> line(end = [0, flangeH])
  |> line(end = [-flangeW, 0])
  |> close()
  |> extrude(length = flangeThk)

jackHoleL = startSketchOn(offsetPlane(XY, offset = -flangeThk - 0.05))
  |> circle(center = [-jackScrewX, 0], radius = jackScrewR)
  |> extrude(length = flangeThk + 0.10)

jackHoleR = startSketchOn(offsetPlane(XY, offset = -flangeThk - 0.05))
  |> circle(center = [jackScrewX, 0], radius = jackScrewR)
  |> extrude(length = flangeThk + 0.10)

// ENGINE NOTE: adding a rectangular window cutter here alongside the two
// jackscrew holes is rejected with "cannot handle this 3D subtraction yet".
// The window is omitted; the insulator sits proud of the flange instead.
export shellFlange = subtract([flangePlate], tools = [jackHoleL, jackHoleR])
  |> appearance(color = colShell, metalness = 80, roughness = 30)

// ===================================================================
// 2 · INSULATOR BLOCK with a bore for EVERY cavity
//     Holes exist whether or not a wire is present.
// ===================================================================
// TRUE D-PROFILE — trapezoid from the datasheet cutout: .777 wide, .440 high,
// sides tapered 10 degrees. This is the polarising shape of a D-sub shell.
insulBlock = startSketchOn(XY)
  |> startProfile(at = [-insulBotW / 2, -insulH / 2])
  |> line(end = [insulBotW, 0])
  |> line(end = [shellTaperInset, insulH])
  |> line(end = [-insulTopW, 0])
  |> close()
  |> extrude(length = insulThk)

cavityCutters = map(allCavities, f = fn(@n) {
  return startSketchOn(offsetPlane(XY, offset = -0.05))
    |> circle(center = [cavX(n), cavY(n)], radius = cavityR)
    |> extrude(length = insulThk + 0.10)
})

export insulator = subtract([insulBlock], tools = cavityCutters)
  |> appearance(color = colInsulator, metalness = 5, roughness = 90)

// ===================================================================
// 3 · CONTACTS — generated ONLY for cavities that carry a wire
// ===================================================================

// engaging pin, protruding through the mating face
export contactPins = map(wireList, f = fn(@w) {
  return startSketchOn(offsetPlane(XY, offset = contactTipZ))
    |> circle(center = [cavX(w.cav), cavY(w.cav)], radius = contactPinR)
    |> extrude(length = contactTipLen + 0.030)
    |> appearance(color = colContact, metalness = 90, roughness = 20)
})

// contact barrel, seated inside the insulator cavity
export contactBodies = map(wireList, f = fn(@w) {
  return startSketchOn(offsetPlane(XY, offset = 0.020))
    |> circle(center = [cavX(w.cav), cavY(w.cav)], radius = contactBodyR)
    |> extrude(length = contactBodyLen)
    |> appearance(color = colContact, metalness = 90, roughness = 20)
})

// crimp barrel, behind the insulator, gripping the conductor
export crimpBarrels = map(wireList, f = fn(@w) {
  return startSketchOn(offsetPlane(XY, offset = crimpStartZ))
    |> circle(center = [cavX(w.cav), cavY(w.cav)], radius = crimpBarrelR)
    |> extrude(length = crimpBarrelLen)
    |> appearance(color = colContact, metalness = 90, roughness = 20)
})

// ===================================================================
// 4 · WIRE — exposed conductor at the crimp, then insulation
// ===================================================================

// stripped conductor, visible between crimp barrel and insulation
export conductors = map(wireList, f = fn(@w) {
  return startSketchOn(offsetPlane(XY, offset = crimpEndZ - 0.010))
    |> circle(center = [cavX(w.cav), cavY(w.cav)], radius = condR(w.awg))
    |> extrude(length = stripLen + 0.010)
    |> appearance(color = colConductor, metalness = 85, roughness = 35)
})

// insulated wire, coloured per the harness data
export wireInsulation = map(wireList, f = fn(@w) {
  return startSketchOn(offsetPlane(XY, offset = conductorEndZ))
    |> circle(center = [cavX(w.cav), cavY(w.cav)], radius = insulR(w.awg))
    |> extrude(length = wireFreeLen)
    |> appearance(color = w.colour, metalness = 0, roughness = 85)
})
