/*
ToolCRIB flush-mount pair — INSERT, round with rear lip
Face sits FLUSH with the panel front. One revolved profile — chamfer baked in.
Generated by generateFlushMountPair(). Edit the named parameters; the
geometry follows. Every derived value states its formula.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

openingDiameter = 25mm  // the panel bore this plugs into
clearancePerSide = 0.15mm
panelThickness = 3mm
chamferAngle = 45deg
chamferDepth = 0.8mm
// insertDiameter = openingDiameter - 2 x clearancePerSide = 24.70mm
insertDiameter = openingDiameter - 2 * clearancePerSide
insertDepth = panelThickness  // flush: the insert face lands level with the panel face
chamferRun = chamferDepth * tan(chamferAngle)  // = 0.80mm
lipOverhang = 2mm  // flange overhang per side behind the panel
lipThickness = 2mm  // flange thickness = overhang, by convention
flangeDiameter = openingDiameter + 2 * lipOverhang  // = 29.00mm
plugDepth = lipThickness + insertDepth  // = 5.00mm total

plugSketch = sketch(on = XZ) {
  s0 = line(start = [var 0mm, var 0mm], end = [var 14.5mm, var 0mm])
  s1 = line(start = [var 14.5mm, var 0mm], end = [var 14.5mm, var 2mm])
  s2 = line(start = [var 14.5mm, var 2mm], end = [var 12.35mm, var 2mm])
  s3 = line(start = [var 12.35mm, var 2mm], end = [var 12.35mm, var 4.2mm])
  s4 = line(start = [var 12.35mm, var 4.2mm], end = [var 11.55mm, var 5mm])
  s5 = line(start = [var 11.55mm, var 5mm], end = [var 0mm, var 5mm])
  s6 = line(start = [var 0mm, var 5mm], end = [var 0mm, var 0mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s4.start])
  coincident([s4.end, s5.start])
  coincident([s5.end, s6.start])
  coincident([s6.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s2)
  vertical(s3)
  horizontal(s5)
  vertical(s6)
  vertical([s0.start, ORIGIN])
  horizontalDistance([ORIGIN, s1.start]) == flangeDiameter / 2
  horizontalDistance([ORIGIN, s3.start]) == insertDiameter / 2
  horizontalDistance([ORIGIN, s5.start]) == insertDiameter / 2 - chamferRun
  horizontal([s0.start, ORIGIN])
  verticalDistance([ORIGIN, s2.start]) == lipThickness
  verticalDistance([ORIGIN, s4.start]) == plugDepth - chamferDepth
  verticalDistance([ORIGIN, s5.start]) == plugDepth
}
plugRegion = region(point = [6.175mm, 1mm], sketch = plugSketch)
plugBody = revolve(plugRegion, axis = Y)
hide(plugSketch)

finishedInsert = appearance(plugBody, color = "#e07a2f", metalness = 5, roughness = 60)
