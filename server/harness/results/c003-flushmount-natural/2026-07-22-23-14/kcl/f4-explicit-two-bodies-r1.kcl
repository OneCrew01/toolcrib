/*
Generated by Text-to-CAD:
Model two separate solid bodies, not one merged solid. Body A: aluminum panel, 60mm square, 3mm thick, square hole 30mm x 30mm through the middle. Body B: aluminum insert that slips into the hole from the front and ends up flush with the panel face, undersized 0.15mm per side for clearance, with 0.5mm x 45 degree chamfers on the leading edges of both the hole and the insert. Make body A gray and body B green.
*/
@settings(defaultLengthUnit = mm)

panelSize = 60mm
panelThickness = 3mm
holeSize = 30mm
clearancePerSide = 0.15mm
insertSize = holeSize - (2 * clearancePerSide)
edgeChamfer = 0.5mm

panelProfile = sketch(on = XY) {
  panelBottom = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  panelRight = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  panelTop = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  panelLeft = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])

  coincident([panelBottom.end, panelRight.start])
  coincident([panelRight.end, panelTop.start])
  coincident([panelTop.end, panelLeft.start])
  coincident([panelLeft.end, panelBottom.start])
  horizontal(panelBottom)
  vertical(panelRight)
  horizontal(panelTop)
  vertical(panelLeft)
  horizontalDistance([panelBottom.start, panelBottom.end]) == panelSize
  verticalDistance([panelRight.start, panelRight.end]) == panelSize
  horizontalDistance([panelBottom.start, ORIGIN]) == panelSize / 2
  verticalDistance([panelBottom.start, ORIGIN]) == panelSize / 2
}

panelRegion = region(point = [0mm, 0mm], sketch = panelProfile)
panelBlank = extrude(panelRegion, length = panelThickness)

holeLowerProfile = sketch(on = offsetPlane(XY, offset = -1mm)) {
  holeLowerBottom = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  holeLowerRight = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  holeLowerTop = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  holeLowerLeft = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])

  coincident([
    holeLowerBottom.end,
    holeLowerRight.start
  ])
  coincident([holeLowerRight.end, holeLowerTop.start])
  coincident([holeLowerTop.end, holeLowerLeft.start])
  coincident([
    holeLowerLeft.end,
    holeLowerBottom.start
  ])
  horizontal(holeLowerBottom)
  vertical(holeLowerRight)
  horizontal(holeLowerTop)
  vertical(holeLowerLeft)
  horizontalDistance([
  holeLowerBottom.start,
  holeLowerBottom.end
]) == holeSize
  verticalDistance([
  holeLowerRight.start,
  holeLowerRight.end
]) == holeSize
  horizontalDistance([holeLowerBottom.start, ORIGIN]) == holeSize / 2
  verticalDistance([holeLowerBottom.start, ORIGIN]) == holeSize / 2
}

holeChamferStartProfile = sketch(on = offsetPlane(XY, offset = panelThickness - edgeChamfer)) {
  holeStartBottom = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  holeStartRight = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  holeStartTop = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  holeStartLeft = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])

  coincident([
    holeStartBottom.end,
    holeStartRight.start
  ])
  coincident([holeStartRight.end, holeStartTop.start])
  coincident([holeStartTop.end, holeStartLeft.start])
  coincident([
    holeStartLeft.end,
    holeStartBottom.start
  ])
  horizontal(holeStartBottom)
  vertical(holeStartRight)
  horizontal(holeStartTop)
  vertical(holeStartLeft)
  horizontalDistance([
  holeStartBottom.start,
  holeStartBottom.end
]) == holeSize
  verticalDistance([
  holeStartRight.start,
  holeStartRight.end
]) == holeSize
  horizontalDistance([holeStartBottom.start, ORIGIN]) == holeSize / 2
  verticalDistance([holeStartBottom.start, ORIGIN]) == holeSize / 2
}

holeLeadProfile = sketch(on = offsetPlane(XY, offset = panelThickness + edgeChamfer)) {
  holeLeadBottom = line(start = [var -16mm, var -16mm], end = [var 16mm, var -16mm])
  holeLeadRight = line(start = [var 16mm, var -16mm], end = [var 16mm, var 16mm])
  holeLeadTop = line(start = [var 16mm, var 16mm], end = [var -16mm, var 16mm])
  holeLeadLeft = line(start = [var -16mm, var 16mm], end = [var -16mm, var -16mm])

  coincident([
    holeLeadBottom.end,
    holeLeadRight.start
  ])
  coincident([holeLeadRight.end, holeLeadTop.start])
  coincident([holeLeadTop.end, holeLeadLeft.start])
  coincident([holeLeadLeft.end, holeLeadBottom.start])
  horizontal(holeLeadBottom)
  vertical(holeLeadRight)
  horizontal(holeLeadTop)
  vertical(holeLeadLeft)
  horizontalDistance([
  holeLeadBottom.start,
  holeLeadBottom.end
]) == holeSize + 4 * edgeChamfer
  verticalDistance([holeLeadRight.start, holeLeadRight.end]) == holeSize + 4 * edgeChamfer
  horizontalDistance([holeLeadBottom.start, ORIGIN]) == holeSize / 2 + 2 * edgeChamfer
  verticalDistance([holeLeadBottom.start, ORIGIN]) == holeSize / 2 + 2 * edgeChamfer
}

holeLowerRegion = region(point = [0mm, 0mm], sketch = holeLowerProfile)
holeChamferStartRegion = region(point = [0mm, 0mm], sketch = holeChamferStartProfile)
holeLeadRegion = region(point = [0mm, 0mm], sketch = holeLeadProfile)
holeCutter = loft(
  [
    holeLowerRegion,
    holeChamferStartRegion,
    holeLeadRegion
  ],
  vDegree = 1,
)
panelWithHole = subtract([panelBlank], tools = [holeCutter])
panelCore = panelWithHole[0]

bodyA = panelCore
  |> appearance(color = "#8b9095", metalness = 78, roughness = 34)

insertLeadProfile = sketch(on = XY) {
  insertLeadBottom = line(start = [var -14.35mm, var -14.35mm], end = [var 14.35mm, var -14.35mm])
  insertLeadRight = line(start = [var 14.35mm, var -14.35mm], end = [var 14.35mm, var 14.35mm])
  insertLeadTop = line(start = [var 14.35mm, var 14.35mm], end = [var -14.35mm, var 14.35mm])
  insertLeadLeft = line(start = [var -14.35mm, var 14.35mm], end = [var -14.35mm, var -14.35mm])

  coincident([
    insertLeadBottom.end,
    insertLeadRight.start
  ])
  coincident([
    insertLeadRight.end,
    insertLeadTop.start
  ])
  coincident([
    insertLeadTop.end,
    insertLeadLeft.start
  ])
  coincident([
    insertLeadLeft.end,
    insertLeadBottom.start
  ])
  horizontal(insertLeadBottom)
  vertical(insertLeadRight)
  horizontal(insertLeadTop)
  vertical(insertLeadLeft)
  horizontalDistance([
  insertLeadBottom.start,
  insertLeadBottom.end
]) == insertSize - (2 * edgeChamfer)
  verticalDistance([
  insertLeadRight.start,
  insertLeadRight.end
]) == insertSize - (2 * edgeChamfer)
  horizontalDistance([insertLeadBottom.start, ORIGIN]) == insertSize / 2 - edgeChamfer
  verticalDistance([insertLeadBottom.start, ORIGIN]) == insertSize / 2 - edgeChamfer
}

insertFullProfile = sketch(on = offsetPlane(XY, offset = edgeChamfer)) {
  insertFullBottom = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  insertFullRight = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  insertFullTop = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  insertFullLeft = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([
    insertFullBottom.end,
    insertFullRight.start
  ])
  coincident([
    insertFullRight.end,
    insertFullTop.start
  ])
  coincident([
    insertFullTop.end,
    insertFullLeft.start
  ])
  coincident([
    insertFullLeft.end,
    insertFullBottom.start
  ])
  horizontal(insertFullBottom)
  vertical(insertFullRight)
  horizontal(insertFullTop)
  vertical(insertFullLeft)
  horizontalDistance([
  insertFullBottom.start,
  insertFullBottom.end
]) == insertSize
  verticalDistance([
  insertFullRight.start,
  insertFullRight.end
]) == insertSize
  horizontalDistance([insertFullBottom.start, ORIGIN]) == insertSize / 2
  verticalDistance([insertFullBottom.start, ORIGIN]) == insertSize / 2
}

insertFaceProfile = sketch(on = offsetPlane(XY, offset = panelThickness)) {
  insertFaceBottom = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  insertFaceRight = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  insertFaceTop = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  insertFaceLeft = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([
    insertFaceBottom.end,
    insertFaceRight.start
  ])
  coincident([
    insertFaceRight.end,
    insertFaceTop.start
  ])
  coincident([
    insertFaceTop.end,
    insertFaceLeft.start
  ])
  coincident([
    insertFaceLeft.end,
    insertFaceBottom.start
  ])
  horizontal(insertFaceBottom)
  vertical(insertFaceRight)
  horizontal(insertFaceTop)
  vertical(insertFaceLeft)
  horizontalDistance([
  insertFaceBottom.start,
  insertFaceBottom.end
]) == insertSize
  verticalDistance([
  insertFaceRight.start,
  insertFaceRight.end
]) == insertSize
  horizontalDistance([insertFaceBottom.start, ORIGIN]) == insertSize / 2
  verticalDistance([insertFaceBottom.start, ORIGIN]) == insertSize / 2
}

insertLeadRegion = region(point = [0mm, 0mm], sketch = insertLeadProfile)
insertFullRegion = region(point = [0mm, 0mm], sketch = insertFullProfile)
insertFaceRegion = region(point = [0mm, 0mm], sketch = insertFaceProfile)
insertSolid = loft(
  [
    insertLeadRegion,
    insertFullRegion,
    insertFaceRegion
  ],
  vDegree = 1,
)

bodyB = insertSolid
  |> appearance(color = "#2f9e44", metalness = 68, roughness = 30)

hide(panelProfile)
hide(holeLowerProfile)
hide(holeChamferStartProfile)
hide(holeLeadProfile)
hide(insertLeadProfile)
hide(insertFullProfile)
hide(insertFaceProfile)

bodyA
bodyB
