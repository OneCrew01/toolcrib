/*
ToolCRIB flush-mount pair — PANEL, round opening
Bore cut through, entry edge chamfered so the insert leads in.
Generated by generateFlushMountPair(). Edit the named parameters; the
geometry follows. Every derived value states its formula.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

panelWidth = 50mm
panelHeight = 50mm
panelThickness = 3mm
openingDiameter = 25mm
chamferAngle = 45deg  // measured from the bore wall
chamferDepth = 0.8mm
cutOverlap = 1mm
chamferRun = 0.8mm  // chamferDepth x tan(chamferAngle) — flare width on the entry face
chamferReach = 1.8mm  // chamferRun x (chamferDepth + cutOverlap) / chamferDepth
faceTopZ = panelThickness + cutOverlap

plateSketch = sketch(on = XY) {
  s0 = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  s1 = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  s2 = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  s3 = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s2)
  vertical(s3)
  horizontalDistance([s0.start, ORIGIN]) == panelWidth / 2
  horizontalDistance([ORIGIN, s1.start]) == panelWidth / 2
  verticalDistance([s0.start, ORIGIN]) == panelHeight / 2
  verticalDistance([ORIGIN, s2.start]) == panelHeight / 2
}
plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
panelBlank = extrude(plateRegion, length = panelThickness)
hide(plateSketch)

boreSketch = sketch(on = XZ) {
  s0 = line(start = [var 0mm, var -1mm], end = [var 12.5mm, var -1mm])
  s1 = line(start = [var 12.5mm, var -1mm], end = [var 12.5mm, var 2.2mm])
  s2 = line(start = [var 12.5mm, var 2.2mm], end = [var 14.3mm, var 4mm])
  s3 = line(start = [var 14.3mm, var 4mm], end = [var 0mm, var 4mm])
  s4 = line(start = [var 0mm, var 4mm], end = [var 0mm, var -1mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s4.start])
  coincident([s4.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s3)
  vertical(s4)
  vertical([s0.start, ORIGIN])
  horizontalDistance([ORIGIN, s1.start]) == openingDiameter / 2
  horizontalDistance([ORIGIN, s3.start]) == openingDiameter / 2 + chamferReach
  verticalDistance([s0.start, ORIGIN]) == cutOverlap
  verticalDistance([ORIGIN, s2.start]) == panelThickness - chamferDepth
  verticalDistance([ORIGIN, s3.start]) == faceTopZ
}
boreRegion = region(point = [6.25mm, 1.5mm], sketch = boreSketch)
boreCutter = revolve(boreRegion, axis = Y)
hide(boreSketch)

panelCut1 = subtract(panelBlank, tools = [boreCutter])
finishedPanel = appearance(panelCut1, color = "#2e5e78", metalness = 5, roughness = 60)
