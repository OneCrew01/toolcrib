/*
Generated by Text-to-CAD:
Flat aluminum plate, 50 mm square and 2 mm thick. Drill four 5 mm holes at the corners, 10 mm in from each edge, and countersink them at 100 degrees so flat-head screws sit flush
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateSize = 50mm
plateThickness = 2mm
holeDiameter = 5mm
holeInset = 10mm
holePitch = plateSize - (2 * holeInset)
countersinkAngle = 100deg
countersinkDiameter = 9mm
cutOverlap = 0.2mm
countersinkDepth = (countersinkDiameter - holeDiameter) / 2 / tan(countersinkAngle / 2)
countersinkTipZ = plateThickness - countersinkDepth
countersinkCutterRadius = countersinkDiameter / 2 + cutOverlap * tan(countersinkAngle / 2)

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateSize
  distance([rightEdge.start, rightEdge.end]) == plateSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateSize / 2
}
plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)

countersunkHoleSketch = sketch(on = XZ) {
  bottomLand = line(start = [var 0mm, var -0.2mm], end = [var 2.5mm, var -0.2mm])
  shankWall = line(start = [var 2.5mm, var -0.2mm], end = [var 2.5mm, var 0.32mm])
  coneWall = line(start = [var 2.5mm, var 0.32mm], end = [var 4.74mm, var 2.2mm])
  topLand = line(start = [var 4.74mm, var 2.2mm], end = [var 0mm, var 2.2mm])
  axisWall = line(start = [var 0mm, var 2.2mm], end = [var 0mm, var -0.2mm])

  coincident([bottomLand.end, shankWall.start])
  coincident([shankWall.end, coneWall.start])
  coincident([coneWall.end, topLand.start])
  coincident([topLand.end, axisWall.start])
  coincident([axisWall.end, bottomLand.start])
  horizontal(bottomLand)
  vertical(shankWall)
  horizontal(topLand)
  vertical(axisWall)
  horizontalDistance([bottomLand.start, ORIGIN]) == 0mm
  verticalDistance([bottomLand.start, ORIGIN]) == cutOverlap
  distance([bottomLand.start, bottomLand.end]) == holeDiameter / 2
  distance([shankWall.start, shankWall.end]) == countersinkTipZ + cutOverlap
  verticalDistance([ORIGIN, topLand.end]) == plateThickness + cutOverlap
  distance([topLand.start, topLand.end]) == countersinkCutterRadius
}
countersunkHoleRegion = region(point = [1mm, 1mm], sketch = countersunkHoleSketch)
countersunkHoleSeed = revolve(countersunkHoleRegion, axis = Y)
  |> translate(x = -holePitch / 2, y = -holePitch / 2, global = true)
countersunkHoleCutters = patternLinear3d(
  patternLinear3d(
    countersunkHoleSeed,
    instances = 2,
    distance = holePitch,
    axis = X,
  ),
  instances = 2,
  distance = holePitch,
  axis = Y,
)
plateCountersunk = subtract(plateBlank, tools = countersunkHoleCutters)

hide(plateSketch)
hide(countersunkHoleSketch)

finishedPlate = appearance(
  plateCountersunk,
  color = "#c5c9cc",
  metalness = 88,
  roughness = 30,
)
