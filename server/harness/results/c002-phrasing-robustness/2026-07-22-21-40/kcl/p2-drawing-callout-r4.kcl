/*
Generated by Text-to-CAD:
Aluminum plate 50 x 50 x 2 mm. 4X drill 5.0 mm THRU, countersink 100 degrees, equally placed at the four corners with hole centers 10 mm from each adjacent edge, for flush flat head screws
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateLength = 50mm
plateWidth = 50mm
plateThickness = 2mm
holeDiameter = 5mm
holeRadius = holeDiameter / 2
holeEdgeInset = 10mm
holeCenterOffset = plateLength / 2 - holeEdgeInset
holePitch = plateLength - (2 * holeEdgeInset)
countersinkIncludedAngle = 100deg
countersinkHalfAngle = countersinkIncludedAngle / 2
countersinkDiameter = 9.5mm
countersinkRadius = countersinkDiameter / 2
countersinkDepth = (countersinkDiameter - holeDiameter) / (2 * tan(countersinkHalfAngle))
countersinkTransitionZ = plateThickness - countersinkDepth
cutOverrun = 0.2mm
countersinkTopRadius = countersinkRadius + cutOverrun * tan(countersinkHalfAngle)

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateLength
  distance([rightEdge.start, rightEdge.end]) == plateWidth
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateLength / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)
hide(plateSketch)

holeCutterSketch = sketch(on = XZ) {
  bottomRadial = line(start = [var 0mm, var -0.2mm], end = [var 2.5mm, var -0.2mm])
  boreWall = line(start = [var 2.5mm, var -0.2mm], end = [var 2.5mm, var 0.11mm])
  countersinkWall = line(start = [var 2.5mm, var 0.11mm], end = [var 4.99mm, var 2.2mm])
  topRadial = line(start = [var 4.99mm, var 2.2mm], end = [var 0mm, var 2.2mm])
  axisWall = line(start = [var 0mm, var 2.2mm], end = [var 0mm, var -0.2mm])

  coincident([bottomRadial.end, boreWall.start])
  coincident([boreWall.end, countersinkWall.start])
  coincident([countersinkWall.end, topRadial.start])
  coincident([topRadial.end, axisWall.start])
  coincident([axisWall.end, bottomRadial.start])
  horizontal(bottomRadial)
  vertical(boreWall)
  horizontal(topRadial)
  vertical(axisWall)
  horizontalDistance([bottomRadial.start, ORIGIN]) == 0mm
  verticalDistance([bottomRadial.start, ORIGIN]) == cutOverrun
  distance([bottomRadial.start, bottomRadial.end]) == holeRadius
  verticalDistance([ORIGIN, boreWall.end]) == countersinkTransitionZ
  verticalDistance([ORIGIN, topRadial.end]) == plateThickness + cutOverrun
  horizontalDistance([ORIGIN, topRadial.start]) == countersinkTopRadius
}

holeCutterRegion = region(point = [1mm, 0mm], sketch = holeCutterSketch)
holeCutterSeed = revolve(holeCutterRegion, axis = Y)
  |> translate(x = -holeCenterOffset, y = -holeCenterOffset, global = true)
holeCutters = patternLinear3d(
  patternLinear3d(
    holeCutterSeed,
    instances = 2,
    distance = holePitch,
    axis = X,
  ),
  instances = 2,
  distance = holePitch,
  axis = Y,
)
hide(holeCutterSketch)

finishedPlate = subtract(plateBlank, tools = holeCutters)
aluminumPlate = appearance(
  finishedPlate,
  color = "#c8ccd0",
  metalness = 88,
  roughness = 28,
)
