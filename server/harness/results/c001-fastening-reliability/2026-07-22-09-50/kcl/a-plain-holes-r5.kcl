/*
Generated by Text-to-CAD:
A 50mm x 50mm x 2mm aluminum plate with four 5mm diameter holes, one near each corner, each hole center 10mm from both adjacent edges
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateLength = 50mm
plateWidth = 50mm
plateThickness = 2mm
holeDiameter = 5mm
holeEdgeOffset = 10mm
holePitchX = plateLength - (2 * holeEdgeOffset)
holePitchY = plateWidth - (2 * holeEdgeOffset)
cutOverlap = 1mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -25mm, var -25mm], end = [var 25mm, var -25mm])
  rightEdge = line(start = [var 25mm, var -25mm], end = [var 25mm, var 25mm])
  topEdge = line(start = [var 25mm, var 25mm], end = [var -25mm, var 25mm])
  leftEdge = line(start = [var -25mm, var 25mm], end = [var -25mm, var -25mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateLength
  distance([rightEdge.start, rightEdge.end]) == plateWidth
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateLength / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)
hiddenPlateSketch = hide(plateSketch)

holeSketch = sketch(on = XY) {
  holeCircle = circle(start = [var -12.5mm, var -15mm], center = [var -15mm, var -15mm])

  horizontal([holeCircle.center, holeCircle.start])
  horizontalDistance([holeCircle.center, ORIGIN]) == plateLength / 2 - holeEdgeOffset
  verticalDistance([holeCircle.center, ORIGIN]) == plateWidth / 2 - holeEdgeOffset
  diameter(holeCircle) == holeDiameter
}

holeRegion = region(point = [-15mm, -15mm], sketch = holeSketch)
holeSeed = extrude(
  holeRegion,
  length = plateThickness + 2 * cutOverlap,
  symmetric = true,
  method = NEW,
)
  |> translate(z = plateThickness / 2, global = true)
holeCutters = patternLinear3d(
  patternLinear3d(
    holeSeed,
    instances = 2,
    distance = holePitchX,
    axis = X,
  ),
  instances = 2,
  distance = holePitchY,
  axis = Y,
)

finishedPlate = subtract(plateBlank, tools = holeCutters)
  |> appearance(color = "#c7c9cc", metalness = 82, roughness = 28)
hiddenHoleSketch = hide(holeSketch)
