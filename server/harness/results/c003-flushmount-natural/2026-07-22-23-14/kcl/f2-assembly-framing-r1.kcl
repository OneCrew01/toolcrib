/*
Generated by Text-to-CAD:
An assembly of two parts made of aluminum: part one is a 60 x 60 x 3 mm face panel with a centered square cutout 30 mm on a side; part two is a matching insert plate sized to drop into that cutout with 0.15 mm of clearance on every side, its top surface flush with the panel. Both mating edges get a small chamfer as a lead-in. Give the two parts different colors, blue panel and yellow insert.
*/
@settings(kclVersion = 2.0, defaultLengthUnit = mm)

panelSize = 60
panelThickness = 3
cutoutSize = 30
clearancePerSide = 0.15
insertSize = cutoutSize - (2 * clearancePerSide)
leadInChamfer = 0.5
chamferStartHeight = panelThickness - leadInChamfer
panelTopOpeningSize = cutoutSize + 2 * leadInChamfer
insertTopSize = insertSize - (2 * leadInChamfer)

panelLowerProfile = sketch(on = XY) {
  outerBottomEdge = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  outerRightEdge = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  outerTopEdge = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  outerLeftEdge = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])
  innerBottomEdge = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  innerRightEdge = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  innerTopEdge = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  innerLeftEdge = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])

  coincident([
    outerBottomEdge.end,
    outerRightEdge.start
  ])
  coincident([outerRightEdge.end, outerTopEdge.start])
  coincident([outerTopEdge.end, outerLeftEdge.start])
  coincident([
    outerLeftEdge.end,
    outerBottomEdge.start
  ])
  coincident([
    innerBottomEdge.end,
    innerRightEdge.start
  ])
  coincident([innerRightEdge.end, innerTopEdge.start])
  coincident([innerTopEdge.end, innerLeftEdge.start])
  coincident([
    innerLeftEdge.end,
    innerBottomEdge.start
  ])

  horizontal(outerBottomEdge)
  vertical(outerRightEdge)
  horizontal(outerTopEdge)
  vertical(outerLeftEdge)
  horizontal(innerBottomEdge)
  vertical(innerRightEdge)
  horizontal(innerTopEdge)
  vertical(innerLeftEdge)

  distance([
  outerBottomEdge.start,
  outerBottomEdge.end
]) == panelSize
  distance([
  outerRightEdge.start,
  outerRightEdge.end
]) == panelSize
  horizontalDistance([outerBottomEdge.start, ORIGIN]) == panelSize / 2
  verticalDistance([outerBottomEdge.start, ORIGIN]) == panelSize / 2
  distance([
  innerBottomEdge.start,
  innerBottomEdge.end
]) == cutoutSize
  distance([
  innerRightEdge.start,
  innerRightEdge.end
]) == cutoutSize
  horizontalDistance([innerBottomEdge.start, ORIGIN]) == cutoutSize / 2
  verticalDistance([innerBottomEdge.start, ORIGIN]) == cutoutSize / 2
}

panelChamferProfile = sketch(on = offsetPlane(XY, offset = chamferStartHeight)) {
  outerBottomEdge = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  outerRightEdge = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  outerTopEdge = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  outerLeftEdge = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])
  innerBottomEdge = line(start = [var -15mm, var -15mm], end = [var 15mm, var -15mm])
  innerRightEdge = line(start = [var 15mm, var -15mm], end = [var 15mm, var 15mm])
  innerTopEdge = line(start = [var 15mm, var 15mm], end = [var -15mm, var 15mm])
  innerLeftEdge = line(start = [var -15mm, var 15mm], end = [var -15mm, var -15mm])

  coincident([
    outerBottomEdge.end,
    outerRightEdge.start
  ])
  coincident([outerRightEdge.end, outerTopEdge.start])
  coincident([outerTopEdge.end, outerLeftEdge.start])
  coincident([
    outerLeftEdge.end,
    outerBottomEdge.start
  ])
  coincident([
    innerBottomEdge.end,
    innerRightEdge.start
  ])
  coincident([innerRightEdge.end, innerTopEdge.start])
  coincident([innerTopEdge.end, innerLeftEdge.start])
  coincident([
    innerLeftEdge.end,
    innerBottomEdge.start
  ])

  horizontal(outerBottomEdge)
  vertical(outerRightEdge)
  horizontal(outerTopEdge)
  vertical(outerLeftEdge)
  horizontal(innerBottomEdge)
  vertical(innerRightEdge)
  horizontal(innerTopEdge)
  vertical(innerLeftEdge)

  distance([
  outerBottomEdge.start,
  outerBottomEdge.end
]) == panelSize
  distance([
  outerRightEdge.start,
  outerRightEdge.end
]) == panelSize
  horizontalDistance([outerBottomEdge.start, ORIGIN]) == panelSize / 2
  verticalDistance([outerBottomEdge.start, ORIGIN]) == panelSize / 2
  distance([
  innerBottomEdge.start,
  innerBottomEdge.end
]) == cutoutSize
  distance([
  innerRightEdge.start,
  innerRightEdge.end
]) == cutoutSize
  horizontalDistance([innerBottomEdge.start, ORIGIN]) == cutoutSize / 2
  verticalDistance([innerBottomEdge.start, ORIGIN]) == cutoutSize / 2
}

panelTopProfile = sketch(on = offsetPlane(XY, offset = panelThickness)) {
  outerBottomEdge = line(start = [var -30mm, var -30mm], end = [var 30mm, var -30mm])
  outerRightEdge = line(start = [var 30mm, var -30mm], end = [var 30mm, var 30mm])
  outerTopEdge = line(start = [var 30mm, var 30mm], end = [var -30mm, var 30mm])
  outerLeftEdge = line(start = [var -30mm, var 30mm], end = [var -30mm, var -30mm])
  innerBottomEdge = line(start = [var -15.5mm, var -15.5mm], end = [var 15.5mm, var -15.5mm])
  innerRightEdge = line(start = [var 15.5mm, var -15.5mm], end = [var 15.5mm, var 15.5mm])
  innerTopEdge = line(start = [var 15.5mm, var 15.5mm], end = [var -15.5mm, var 15.5mm])
  innerLeftEdge = line(start = [var -15.5mm, var 15.5mm], end = [var -15.5mm, var -15.5mm])

  coincident([
    outerBottomEdge.end,
    outerRightEdge.start
  ])
  coincident([outerRightEdge.end, outerTopEdge.start])
  coincident([outerTopEdge.end, outerLeftEdge.start])
  coincident([
    outerLeftEdge.end,
    outerBottomEdge.start
  ])
  coincident([
    innerBottomEdge.end,
    innerRightEdge.start
  ])
  coincident([innerRightEdge.end, innerTopEdge.start])
  coincident([innerTopEdge.end, innerLeftEdge.start])
  coincident([
    innerLeftEdge.end,
    innerBottomEdge.start
  ])

  horizontal(outerBottomEdge)
  vertical(outerRightEdge)
  horizontal(outerTopEdge)
  vertical(outerLeftEdge)
  horizontal(innerBottomEdge)
  vertical(innerRightEdge)
  horizontal(innerTopEdge)
  vertical(innerLeftEdge)

  distance([
  outerBottomEdge.start,
  outerBottomEdge.end
]) == panelSize
  distance([
  outerRightEdge.start,
  outerRightEdge.end
]) == panelSize
  horizontalDistance([outerBottomEdge.start, ORIGIN]) == panelSize / 2
  verticalDistance([outerBottomEdge.start, ORIGIN]) == panelSize / 2
  distance([
  innerBottomEdge.start,
  innerBottomEdge.end
]) == panelTopOpeningSize
  distance([
  innerRightEdge.start,
  innerRightEdge.end
]) == panelTopOpeningSize
  horizontalDistance([innerBottomEdge.start, ORIGIN]) == panelTopOpeningSize / 2
  verticalDistance([innerBottomEdge.start, ORIGIN]) == panelTopOpeningSize / 2
}

panelLowerRegion = region(point = [20mm, 0mm], sketch = panelLowerProfile)
panelChamferRegion = region(point = [20mm, 0mm], sketch = panelChamferProfile)
panelTopRegion = region(point = [20mm, 0mm], sketch = panelTopProfile)
bluePanel = loft(
  [
    panelLowerRegion,
    panelChamferRegion,
    panelTopRegion
  ],
  vDegree = 1,
)
  |> appearance(color = "#2468C4", metalness = 82, roughness = 30)

insertLowerProfile = sketch(on = XY) {
  bottomEdge = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  rightEdge = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  topEdge = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  leftEdge = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == insertSize
  distance([rightEdge.start, rightEdge.end]) == insertSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == insertSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == insertSize / 2
}

insertChamferProfile = sketch(on = offsetPlane(XY, offset = chamferStartHeight)) {
  bottomEdge = line(start = [var -14.85mm, var -14.85mm], end = [var 14.85mm, var -14.85mm])
  rightEdge = line(start = [var 14.85mm, var -14.85mm], end = [var 14.85mm, var 14.85mm])
  topEdge = line(start = [var 14.85mm, var 14.85mm], end = [var -14.85mm, var 14.85mm])
  leftEdge = line(start = [var -14.85mm, var 14.85mm], end = [var -14.85mm, var -14.85mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == insertSize
  distance([rightEdge.start, rightEdge.end]) == insertSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == insertSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == insertSize / 2
}

insertTopProfile = sketch(on = offsetPlane(XY, offset = panelThickness)) {
  bottomEdge = line(start = [var -14.35mm, var -14.35mm], end = [var 14.35mm, var -14.35mm])
  rightEdge = line(start = [var 14.35mm, var -14.35mm], end = [var 14.35mm, var 14.35mm])
  topEdge = line(start = [var 14.35mm, var 14.35mm], end = [var -14.35mm, var 14.35mm])
  leftEdge = line(start = [var -14.35mm, var 14.35mm], end = [var -14.35mm, var -14.35mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == insertTopSize
  distance([rightEdge.start, rightEdge.end]) == insertTopSize
  horizontalDistance([bottomEdge.start, ORIGIN]) == insertTopSize / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == insertTopSize / 2
}

insertLowerRegion = region(point = [0mm, 0mm], sketch = insertLowerProfile)
insertChamferRegion = region(point = [0mm, 0mm], sketch = insertChamferProfile)
insertTopRegion = region(point = [0mm, 0mm], sketch = insertTopProfile)
yellowInsert = loft(
  [
    insertLowerRegion,
    insertChamferRegion,
    insertTopRegion
  ],
  vDegree = 1,
)
  |> appearance(color = "#F2C230", metalness = 82, roughness = 30)

hiddenPanelLowerProfile = hide(panelLowerProfile)
hiddenPanelChamferProfile = hide(panelChamferProfile)
hiddenPanelTopProfile = hide(panelTopProfile)
hiddenInsertLowerProfile = hide(insertLowerProfile)
hiddenInsertChamferProfile = hide(insertChamferProfile)
hiddenInsertTopProfile = hide(insertTopProfile)
