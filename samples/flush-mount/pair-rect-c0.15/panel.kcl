/*
ToolCRIB flush-mount pair — PANEL, rect opening
Opening cut through, entry edge chamfered so the insert leads in.
Generated by generateFlushMountPair(). Edit the named parameters; the
geometry follows. Every derived value states its formula.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

panelWidth = 60mm
panelHeight = 40mm
panelThickness = 3mm
openingWidth = 30mm
openingHeight = 20mm
chamferAngle = 45deg  // measured from the opening wall
chamferDepth = 0.8mm
cutOverlap = 1mm
chamferRun = 0.8mm  // chamferDepth x tan(chamferAngle) — the flare width on the entry face
chamferReach = 1.8mm  // chamferRun x (chamferDepth + cutOverlap) / chamferDepth — taper extended past the face
chamferBite = 0.35mm  // overshoot along the taper — keeps boolean cuts off coincident faces
wedgeLowZ = 1.85mm  // panelThickness - chamferDepth - chamferBite x chamferDepth / chamferRun
faceTopZ = panelThickness + cutOverlap
wedgeSpanY = openingHeight + 2 * chamferReach + 2mm
wedgeSpanX = openingWidth + 2 * chamferReach + 2mm

plateSketch = sketch(on = XY) {
  s0 = line(start = [var -30mm, var -20mm], end = [var 30mm, var -20mm])
  s1 = line(start = [var 30mm, var -20mm], end = [var 30mm, var 20mm])
  s2 = line(start = [var 30mm, var 20mm], end = [var -30mm, var 20mm])
  s3 = line(start = [var -30mm, var 20mm], end = [var -30mm, var -20mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s2)
  vertical(s3)
  horizontalDistance([s0.start, ORIGIN]) == panelWidth / 2
  horizontalDistance([ORIGIN, s1.start]) == panelWidth / 2
  verticalDistance([s0.start, ORIGIN]) == panelHeight / 2
  verticalDistance([ORIGIN, s2.start]) == panelHeight / 2
}
plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
panelBlank = extrude(plateRegion, length = panelThickness)
hide(plateSketch)

openingSketch = sketch(on = XY) {
  s0 = line(start = [var -15mm, var -10mm], end = [var 15mm, var -10mm])
  s1 = line(start = [var 15mm, var -10mm], end = [var 15mm, var 10mm])
  s2 = line(start = [var 15mm, var 10mm], end = [var -15mm, var 10mm])
  s3 = line(start = [var -15mm, var 10mm], end = [var -15mm, var -10mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s3.start])
  coincident([s3.end, s0.start])
  horizontal(s0)
  vertical(s1)
  horizontal(s2)
  vertical(s3)
  horizontalDistance([s0.start, ORIGIN]) == openingWidth / 2
  horizontalDistance([ORIGIN, s1.start]) == openingWidth / 2
  verticalDistance([s0.start, ORIGIN]) == openingHeight / 2
  verticalDistance([ORIGIN, s2.start]) == openingHeight / 2
}
openingRegion = region(point = [0mm, 0mm], sketch = openingSketch)
openingCutter = extrude(openingRegion, length = panelThickness + 2 * cutOverlap, symmetric = true, method = NEW)
  |> translate(z = panelThickness / 2, global = true)
hide(openingSketch)

wedgeEastSketch = sketch(on = XZ) {
  s0 = line(start = [var 14.65mm, var 1.85mm], end = [var 16.8mm, var 4mm])
  s1 = line(start = [var 16.8mm, var 4mm], end = [var 14.65mm, var 4mm])
  s2 = line(start = [var 14.65mm, var 4mm], end = [var 14.65mm, var 1.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([ORIGIN, s0.start]) == openingWidth / 2 - chamferBite
  horizontalDistance([ORIGIN, s1.start]) == openingWidth / 2 + chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeEastRegion = region(point = [15.3667mm, 3.2833mm], sketch = wedgeEastSketch)
wedgeEastCutter = extrude(wedgeEastRegion, length = wedgeSpanY, symmetric = true, method = NEW)
hide(wedgeEastSketch)

wedgeWestSketch = sketch(on = XZ) {
  s0 = line(start = [var -14.65mm, var 1.85mm], end = [var -16.8mm, var 4mm])
  s1 = line(start = [var -16.8mm, var 4mm], end = [var -14.65mm, var 4mm])
  s2 = line(start = [var -14.65mm, var 4mm], end = [var -14.65mm, var 1.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([s0.start, ORIGIN]) == openingWidth / 2 - chamferBite
  horizontalDistance([s1.start, ORIGIN]) == openingWidth / 2 + chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeWestRegion = region(point = [-15.3667mm, 3.2833mm], sketch = wedgeWestSketch)
wedgeWestCutter = extrude(wedgeWestRegion, length = wedgeSpanY, symmetric = true, method = NEW)
hide(wedgeWestSketch)

wedgeNorthSketch = sketch(on = YZ) {
  s0 = line(start = [var 9.65mm, var 1.85mm], end = [var 11.8mm, var 4mm])
  s1 = line(start = [var 11.8mm, var 4mm], end = [var 9.65mm, var 4mm])
  s2 = line(start = [var 9.65mm, var 4mm], end = [var 9.65mm, var 1.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([ORIGIN, s0.start]) == openingHeight / 2 - chamferBite
  horizontalDistance([ORIGIN, s1.start]) == openingHeight / 2 + chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeNorthRegion = region(point = [10.3667mm, 3.2833mm], sketch = wedgeNorthSketch)
wedgeNorthCutter = extrude(wedgeNorthRegion, length = wedgeSpanX, symmetric = true, method = NEW)
hide(wedgeNorthSketch)

wedgeSouthSketch = sketch(on = YZ) {
  s0 = line(start = [var -9.65mm, var 1.85mm], end = [var -11.8mm, var 4mm])
  s1 = line(start = [var -11.8mm, var 4mm], end = [var -9.65mm, var 4mm])
  s2 = line(start = [var -9.65mm, var 4mm], end = [var -9.65mm, var 1.85mm])

  coincident([s0.end, s1.start])
  coincident([s1.end, s2.start])
  coincident([s2.end, s0.start])
  horizontal(s1)
  vertical(s2)
  horizontalDistance([s0.start, ORIGIN]) == openingHeight / 2 - chamferBite
  horizontalDistance([s1.start, ORIGIN]) == openingHeight / 2 + chamferReach
  verticalDistance([ORIGIN, s0.start]) == wedgeLowZ
  verticalDistance([ORIGIN, s1.start]) == faceTopZ
}
wedgeSouthRegion = region(point = [-10.3667mm, 3.2833mm], sketch = wedgeSouthSketch)
wedgeSouthCutter = extrude(wedgeSouthRegion, length = wedgeSpanX, symmetric = true, method = NEW)
hide(wedgeSouthSketch)

panelCut1 = subtract(panelBlank, tools = [openingCutter])
panelCut2 = subtract(panelCut1, tools = [wedgeEastCutter])
panelCut3 = subtract(panelCut2, tools = [wedgeWestCutter])
panelCut4 = subtract(panelCut3, tools = [wedgeNorthCutter])
panelCut5 = subtract(panelCut4, tools = [wedgeSouthCutter])
finishedPanel = appearance(panelCut5, color = "#2e5e78", metalness = 5, roughness = 60)
