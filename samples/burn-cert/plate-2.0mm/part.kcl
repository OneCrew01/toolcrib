/*
ToolCRIB burn-cert coupon plate — 2.0 mm wall, built to PASS our own gate.
Floor under test: PC-ABS-FR minimum wall 1.5 mm (BC-003, PENDING operator
sign-off — docs/VERIFICATION_LOG.md). Passing our gate is passing our gate;
nothing here has been graded against anything. Edit the named parameters; the
geometry follows.
ADVISORY — design-for-burn-cert, not certification.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateWidth = 60mm
plateHeight = 40mm
plateThickness = 2mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -30mm, var -20mm], end = [var 30mm, var -20mm])
  rightEdge = line(start = [var 30mm, var -20mm], end = [var 30mm, var 20mm])
  topEdge = line(start = [var 30mm, var 20mm], end = [var -30mm, var 20mm])
  leftEdge = line(start = [var -30mm, var 20mm], end = [var -30mm, var -20mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateRegion = region(point = [0mm, 0mm], sketch = plateSketch)
plateBlank = extrude(plateRegion, length = plateThickness)
hiddenPlateSketch = hide(plateSketch)

finishedPlate = appearance(
  plateBlank,
  color = "#2e5e78",
  metalness = 5,
  roughness = 60,
)
